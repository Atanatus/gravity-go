<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>GRAVITY GO — v0.1</title>
<style>
:root{color-scheme:dark;--bg:#090d15;--panel:#111927;--line:#29354a;--blue:#f5f5f5;--red:#aeb5c0;--text:#f0f5ff;--muted:#9ba9bf;--gold:#ffd166}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at top,#17243a 0,#090d15 65%);color:var(--text);font-family:Segoe UI,Arial,sans-serif;min-height:100vh}
button,select{font:inherit}
button{border:1px solid #34435a;background:#1b293d;color:var(--text);border-radius:10px;padding:11px 15px;cursor:pointer;touch-action:manipulation}
button:hover{background:#263951}
button:disabled{opacity:.4;cursor:default}
header{text-align:center;padding:18px 10px 8px}
.logo{font-weight:950;font-size:clamp(27px,5vw,43px);letter-spacing:5px}
.logo span{color:var(--blue)}
.sub{color:var(--muted);font-size:12px;letter-spacing:3px;margin-top:4px}
main{width:min(1050px,100%);margin:auto;padding:10px 14px 25px}
.topbar{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:stretch;margin-bottom:12px}
.player{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:12px;min-width:0}
.player.red{text-align:right}
.player.active{border-color:var(--gold);box-shadow:0 0 0 1px #ffd16630}
.pname{font-size:12px;letter-spacing:2px;color:var(--muted)}
.score{font-size:clamp(25px,5vw,38px);font-weight:900;line-height:1.25}
.blue .score{color:#f5f5f5}.red .score{color:#aeb5c0}
.target{font-size:11px;color:var(--muted)}
.clock{background:#101827;border:1px solid var(--line);border-radius:13px;min-width:108px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:8px 12px}
.clock strong{font-size:clamp(23px,4vw,32px);font-variant-numeric:tabular-nums}
.clock small{color:var(--muted);font-size:10px;letter-spacing:1px}
.clock.urgent strong{color:var(--red)}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 235px;gap:14px;align-items:start}
.boardwrap{background:#0d1420;border:1px solid var(--line);border-radius:14px;padding:10px;min-width:0}
#board{width:100%;display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:4px;touch-action:manipulation}
.cell{aspect-ratio:1;border-radius:4px;background:#182437;border:1px solid #29374d;position:relative;min-width:0}
.cell::after{content:"";position:absolute;inset:15%;border-radius:3px;opacity:0}
.cell.blue::after,.cell.red::after{opacity:1}
.cell.blue::after{background:#f5f5f5;border:1px solid #fff;box-shadow:0 0 7px #ffffff35}
.cell.red::after{background:#080a0e;border:1px solid #d8dce4;box-shadow:inset 0 0 0 1px #000}
.cell.falling{outline:2px solid white;outline-offset:-2px}
/* PREVIEW_GHOST_V2 */
.cell.prep-preview{
 outline:2px dashed #ffd166;
 outline-offset:-3px;
 background:rgba(255,209,102,.12);
 box-shadow:inset 0 0 18px rgba(255,209,102,.18);
}
.cell.prep-preview::after{
 opacity:.38!important;
 border:2px dashed #ffd166!important;
 box-shadow:0 0 15px rgba(255,209,102,.45)!important;
 transform:scale(.88);
}
#prep-panel{
 gap:12px!important;
 box-shadow:0 5px 24px rgba(0,0,0,.2);
}
#prep-title{font-size:14px;letter-spacing:1px}
#prep-help{font-size:13px;line-height:1.55}
#prep-confirm{min-height:44px;font-weight:700}
.cell.ghost{background:#243a50}
.side{display:flex;flex-direction:column;gap:12px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:14px}
.card h3{font-size:12px;letter-spacing:2px;margin:0 0 11px;color:var(--muted)}
.status{font-size:14px;line-height:1.5;min-height:45px}
.mode{width:100%;background:#0c1420;color:var(--text);border:1px solid var(--line);padding:10px;border-radius:9px;margin-bottom:9px}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.actions button{padding:10px 6px}
.primary{background:#174b77;border-color:#277fbd}
.rules{font-size:12px;line-height:1.65;color:var(--muted)}
.rules b{color:var(--text)}
.controls{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:10px}
.controls button{font-size:20px;padding:12px 4px;user-select:none}
.hint{text-align:center;color:var(--muted);font-size:11px;margin:10px 0 2px}
#overlay{position:fixed;inset:0;background:#050810d9;display:none;align-items:center;justify-content:center;padding:20px;z-index:5}
#overlay.show{display:flex}
.modal{width:min(400px,100%);background:#111927;border:1px solid #42516a;border-radius:18px;padding:25px;text-align:center;box-shadow:0 20px 80px #0009}
.modal h2{font-size:27px;margin:0 0 10px}
.modal p{color:var(--muted);line-height:1.5}
.modal button{margin-top:10px}
/* PAUSE_MENU_V1 */
#pause-overlay{
 position:fixed;inset:0;z-index:9000;display:none;
 align-items:center;justify-content:center;padding:20px;
 background:#050810e8;backdrop-filter:blur(5px);
}
#pause-overlay.show{display:flex}
.pause-modal{
 width:min(400px,100%);padding:28px 24px;text-align:center;
 background:linear-gradient(145deg,#172338,#0d1420);
 border:1px solid #42516a;border-radius:18px;
 box-shadow:0 20px 80px #000b;
}
.pause-kicker{font-size:10px;letter-spacing:4px;color:#ffd166;margin-bottom:12px}
.pause-modal h2{font-size:30px;margin:0 0 8px;letter-spacing:2px}
.pause-modal p{color:#9ba9bf;font-size:13px;line-height:1.6;margin:0 0 20px}
.pause-actions{display:grid;gap:10px}
.pause-actions button{width:100%;min-height:48px;font-weight:750}
.pause-actions .pause-menu-button{background:#111927;border-color:#42516a}
#pause-overlay button:focus-visible{outline:2px solid #ffd166;outline-offset:3px}
@media(max-width:680px){
 main{padding:7px 9px 18px}
 .layout{grid-template-columns:1fr}
 .side{display:grid;grid-template-columns:1fr 1fr}
 .side .rulescard{grid-column:1/-1}
 .boardwrap{padding:7px}
 #board{gap:3px}
 .cell{border-radius:3px}
 .topbar{gap:5px}
 .player{padding:9px}
 .clock{min-width:83px;padding:6px}
 .controls button{padding:14px 4px}
}

/* Sorteo inicial: duelo de dados */
.dice-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(0,0,0,.94);
  color: #fff;
  text-align: center;
  backdrop-filter: blur(12px);
}
.dice-overlay.show { display: flex; }
.dice-panel { width: min(540px, 100%); }
.dice-kicker {
  font-size: 11px;
  letter-spacing: .3em;
  text-transform: uppercase;
  color: #aaa;
  margin-bottom: 12px;
}
.dice-title {
  font-size: clamp(26px, 6vw, 42px);
  font-weight: 900;
  letter-spacing: -.04em;
  margin: 0 0 10px;
}
.dice-subtitle { color: #aaa; font-size: 14px; margin-bottom: 30px; }
.dice-arena {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16px;
}
.dice-contestant { display: grid; justify-items: center; gap: 13px; }
.dice-player-name {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .15em;
  color: #ccc;
}
.dice-face {
  width: clamp(82px, 20vw, 118px);
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  border: 2px solid #fff;
  border-radius: 22px;
  background: linear-gradient(145deg, #fff, #d8d8d8);
  color: #080808;
  font-size: clamp(48px, 11vw, 68px);
  font-weight: 900;
  box-shadow: 0 0 0 1px rgba(255,255,255,.12),
              0 12px 40px rgba(255,255,255,.09);
  transform: rotate(0deg) scale(1);
}
.dice-face.rolling { animation: dice-shake .16s infinite alternate; }
.dice-vs { font-size: 12px; font-weight: 900; color: #777; }
.dice-status {
  min-height: 52px;
  display: grid;
  place-items: center;
  margin-top: 28px;
  font-size: 16px;
  font-weight: 800;
}
.dice-status.winner { font-size: 20px; }
.dice-hint {
  margin-top: 8px;
  font-size: 10px;
  letter-spacing: .16em;
  color: #777;
  text-transform: uppercase;
}
@keyframes dice-shake {
  from { transform: rotate(-9deg) scale(.94); }
  to { transform: rotate(9deg) scale(1.06); }
}
@media (prefers-reduced-motion: reduce) {
  .dice-face.rolling { animation: none; }
}
/* GRAVITY_GO_MAIN_MENU_V1 */
#main-menu{
 position:fixed;inset:0;z-index:20000;display:none;overflow-y:auto;
 align-items:center;justify-content:center;padding:24px 16px;
 background:radial-gradient(ellipse at 50% 15%,#203653 0,#0a101b 55%,#05080e 100%);
}
#main-menu.show{display:flex}
.menu-inner{width:min(520px,100%);text-align:center;padding:28px 0}
.menu-brand{font-size:clamp(36px,9vw,64px);font-weight:950;letter-spacing:5px;line-height:1.1}
.menu-brand span{color:#ffd166}
.menu-eyebrow{font-size:10px;letter-spacing:4px;color:#9ba9bf;margin:14px 0 34px}
.menu-tagline{font-size:clamp(17px,4vw,23px);font-weight:700;margin:0 0 9px}
.menu-description{font-size:13px;line-height:1.7;color:#9ba9bf;margin:0 auto 28px;max-width:350px}
.menu-options{display:grid;gap:12px;text-align:left}
.menu-option{
 display:flex;align-items:center;gap:15px;width:100%;min-height:76px;
 padding:15px 17px;background:linear-gradient(110deg,#17263a,#101927);
 border:1px solid #34445b;border-radius:14px;text-align:left;
 transition:border-color .15s,transform .15s,background .15s;
}
.menu-option:hover{border-color:#ffd166;background:#1b2c41;transform:translateY(-1px)}
.menu-option.primary{background:linear-gradient(110deg,#174b77,#153451);border-color:#3989bd}
.menu-option.primary:hover{background:linear-gradient(110deg,#205e91,#194363)}
.menu-icon{
 flex:0 0 42px;width:42px;height:42px;display:grid;place-items:center;
 border-radius:11px;background:#ffffff0c;color:#ffd166;font-size:22px;font-weight:800
}
.menu-option-copy{display:grid;gap:5px}
.menu-option-copy strong{font-size:15px;letter-spacing:.2px}
.menu-option-copy small{font-size:12px;line-height:1.4;color:#a8b5c8}
.menu-footer{margin-top:27px;color:#66758b;font-size:10px;letter-spacing:2px}
#main-menu button:focus-visible{outline:2px solid #ffd166;outline-offset:3px}
.menu-return{margin-top:14px!important;width:100%}

/* GRAVITY_GO_LOCAL_VIEWPORT_FIT_V1 */
@media (min-width: 681px) {
  html, body {
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  body {
    height: 100vh;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  header {
    padding-top: 3px;
    padding-bottom: 3px;
  }

  main {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 0;
    height: auto;
    margin: 0;
    padding: 4px 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .topbar {
    flex: 0 0 auto;
    margin-bottom: 5px;
  }

  .layout {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    grid-template-columns: minmax(0, 1fr) 210px;
    align-items: stretch;
    gap: 8px;
    overflow: hidden;
  }

  .layout > div:first-child {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto auto auto;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .boardwrap {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #board {
    flex: 0 0 auto;
    margin: auto;
    gap: 2px;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    grid-template-rows: repeat(12, minmax(0, 1fr));
  }

  #board .cell {
    box-sizing: border-box;
    min-width: 0;
    min-height: 0;
    aspect-ratio: auto;
  }

  .controls {
    min-width: 0;
    margin-top: 5px;
  }

  .hint {
    margin-top: 3px;
  }

  .side {
    min-width: 0;
    min-height: 0;
    overflow-y: auto;
    gap: 5px;
  }

  .card {
    padding: 9px;
  }
}
/* GRAVITY_GO_LOCAL_BOARD_LAYOUT_V2 */
@media (min-width: 681px) {
  .layout > div:first-child {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    grid-template-rows: minmax(0, 1fr) auto auto;
    align-items: stretch;
    gap: 8px;
  }

  .layout > div:first-child > .boardwrap {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
  }

  .layout > div:first-child > #prep-panel {
    grid-column: 2;
    grid-row: 1;
    box-sizing: border-box;
    width: 100% !important;
    min-width: 0;
    min-height: 0;
    max-height: 100%;
    margin: 0 !important;
    padding: 10px !important;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .layout > div:first-child > .controls {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-top: 0;
    min-width: 0;
  }

  .layout > div:first-child > .hint {
    grid-column: 1 / -1;
    grid-row: 3;
    margin-top: 0;
  }
}

/* GRAVITY_GO_LOCAL_BOARD_LAYOUT_V3 */
@media (min-width: 681px) {
  .layout > div:first-child {
    grid-template-columns: minmax(0, 1fr) 176px;
    grid-template-rows: minmax(0, 1fr) auto auto;
    column-gap: 10px;
    row-gap: 6px;
  }

  .layout > div:first-child > .boardwrap {
    padding: 4px;
    justify-content: center;
    align-items: center;
  }

  .layout > div:first-child > #prep-panel {
    padding: 9px !important;
    gap: 7px !important;
    overflow-y: auto;
    overflow-x: hidden;
    align-self: stretch;
  }

  #prep-title {
    font-size: 12px;
    letter-spacing: .6px;
    line-height: 1.3;
  }

  #prep-help {
    font-size: 11px;
    line-height: 1.35;
  }

  #prep-confirm {
    min-height: 38px;
    padding: 8px 6px;
    font-size: 12px;
  }

  .layout > div:first-child > .controls {
    margin-top: 0;
  }

  .layout > div:first-child > .hint {
    margin-top: 0;
  }
}

/* GRAVITY_GO_COMPACT_MATCH_UI_V1 */
@media (min-width: 681px) {
  .side #mode {
    display: none !important;
  }

  .side .rulescard {
    display: none !important;
  }

  .topbar {
    margin-bottom: 4px !important;
  }

  .topbar .player {
    padding: 6px !important;
  }

  .layout {
    gap: 8px !important;
  }

  .layout > div:first-child > .boardwrap {
    padding: 4px !important;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .layout > div:first-child > .controls {
    margin-top: 0 !important;
  }
}
</style>
</head>
<body>
<header>
  <div class="logo">GRAVITY <span>GO</span></div>
  <div class="sub">STRATEGY MEETS GRAVITY · VERSION 0.1</div>
</header>
<main>
  <section class="topbar">
    <div id="pBlue" class="player blue">
      <div class="pname">JUGADOR BLANCO</div>
      <div class="score" id="scoreBlue">0</div>
      <div class="target">OBJETIVO: 20 CAPTURAS</div>
    </div>
    <div class="clock" id="clock">
      <small>TIEMPO</small>
      <strong id="time">10:00</strong>
      <small>POR PARTIDA</small>
    </div>
    <div id="pRed" class="player red">
      <div class="pname" id="redName">JUGADOR ROJO</div>
      <div class="score" id="scoreRed">0</div>
      <div class="target">OBJETIVO: 20 CAPTURAS</div>
    </div>
  </section>

  <section class="layout">
    <div>
      <div class="boardwrap"><div id="board" aria-label="Tablero de Gravity Go"></div></div>
<div id="prep-panel" style="display:none;margin-top:10px;padding:14px;background:#111927;border:1px solid #ffd16666;border-radius:13px;gap:10px;flex-direction:column">
<strong id="prep-title" style="color:#ffd166">COLOCACIÓN INICIAL</strong>
<p id="prep-help">Selecciona una columna libre y confirma.</p>
<button id="prep-confirm" class="primary" disabled>Confirmar posición</button>
</div>
      <div class="controls">
        <button id="left" aria-label="Mover a la izquierda">←</button>
        <button id="down" aria-label="Acelerar caída">↓ Acelerar</button>
        <button id="right" aria-label="Mover a la derecha">→</button>
      </div>
      <div class="hint">Teclado: ← → para mover · ↓ para acelerar · P para pausar</div>
    </div>

    <aside class="side">
      <div class="card">
        <h3>PARTIDA</h3>
        <select id="mode" class="mode">
          <option value="ai">Jugador vs IA</option>
          <option value="local">Dos jugadores locales</option>
        </select>
        <div class="actions">
          <button id="new" class="primary">Nueva partida</button>
          <button id="pause">Pausar</button>
        </div>
      </div>
      <div class="card">
        <h3>ESTADO</h3>
        <div class="status" id="status" aria-live="polite">Preparando tablero...</div>
      </div>
      <div class="card rulescard">
        <h3>REGLAS DE VICTORIA</h3>
        <div class="rules">
          <b>20 capturas:</b> victoria inmediata.<br>
          <b>10 minutos:</b> límite de la partida.<br>
          <b>Tiempo agotado:</b> gana quien tenga más capturas.<br>
          <b>Empate:</b> muerte súbita; la siguiente captura decide la partida.<br>
          <b>Puntuación:</b> cada cubo enemigo eliminado vale 1 punto, también en cadenas.<br>
          <b>Gravedad:</b> los cubos supervivientes caen después de las capturas.
        </div>
      </div>
    </aside>
  </section>
</main>

<div id="main-menu" class="show" role="dialog" aria-modal="true" aria-label="Menú principal">
  <div class="menu-inner">
    <div class="menu-brand">GRAVITY <span>GO</span></div>
    <div class="menu-eyebrow">STRATEGY MEETS GRAVITY</div>
    <h1 class="menu-tagline">Cada movimiento cuenta.</h1>
    <p class="menu-description">Controla la gravedad. Protege tus grupos. Captura para ganar.</p>
    <div class="menu-options">
      <button id="menu-ai" class="menu-option primary">
        <span class="menu-icon">◆</span>
        <span class="menu-option-copy">
          <strong>Jugar contra la IA</strong>
          <small>Un duelo estratégico contra la máquina.</small>
        </span>
      </button>
      <button id="menu-local" class="menu-option">
        <span class="menu-icon">Ⅱ</span>
        <span class="menu-option-copy">
          <strong>Dos jugadores locales</strong>
          <small>Dos personas, un tablero y una sola victoria.</small>
        </span>
      </button>
      <button id="menu-online" class="menu-option">
        <span class="menu-icon">↗</span>
        <span class="menu-option-copy">
          <strong>Modo online</strong>
          <small>Accede a la versión online del juego.</small>
        </span>
      </button>
    </div>
    <div class="menu-footer">GRAVITY GO · VERSION 0.1</div>
  </div>
</div>
<div id="overlay">
  <div class="modal">
    <h2 id="resultTitle">Fin de partida</h2>
    <p id="resultText"></p>
    <button id="again" class="primary">Jugar otra vez</button>
    <button id="to-menu" class="menu-return">Menú principal</button>
  </div>
</div>

<div id="pause-overlay" role="dialog" aria-modal="true" aria-labelledby="pause-title">
  <div class="pause-modal">
    <div class="pause-kicker">GRAVITY GO</div>
    <h2 id="pause-title">EN PAUSA</h2>
    <p>Tu partida está detenida. ¿Qué quieres hacer?</p>
    <div class="pause-actions">
      <button id="pause-continue" class="primary">▶ CONTINUAR PARTIDA</button>
      <button id="pause-to-menu" class="pause-menu-button">⌂ VOLVER AL MENÚ PRINCIPAL</button>
    </div>
  </div>
</div>
<div id="dice-overlay" class="dice-overlay" role="dialog" aria-modal="true" aria-labelledby="dice-title">
  <div class="dice-panel">
    <div class="dice-kicker">Gravity Go · Sorteo inicial</div>
    <h2 id="dice-title" class="dice-title">QUE GANE EL MÁS ALTO</h2>
    <div class="dice-subtitle">Dos dados. Un solo ganador. El número más alto empieza.</div>
    <div class="dice-arena">
      <div class="dice-contestant">
        <div id="dice-name-1" class="dice-player-name">JUGADOR 1</div>
        <div id="dice-face-1" class="dice-face">⚄</div>
      </div>
      <div class="dice-vs">VS</div>
      <div class="dice-contestant">
        <div id="dice-name-2" class="dice-player-name">JUGADOR 2</div>
        <div id="dice-face-2" class="dice-face">⚄</div>
      </div>
    </div>
    <div id="dice-status" class="dice-status" aria-live="polite">Preparando el lanzamiento...</div>
    <div class="dice-hint">El empate obliga a repetir</div>
  </div>
</div>
<script>
"use strict";
const W=8,H=12,GOAL=20,MATCH_SECONDS=600;
const BLUE=1,RED=2;
const SPAWN_ORDER=[3,4,2,5,1,6,0,7];
const $=id=>document.getElementById(id);
let board,piece,player,scores,mode,remaining,gameOver,paused,suddenDeath;
let lastFrame=0,fallAccumulator=0,turnWait=0,aiTarget=null,aiThink=0;
let lastStatus="",fastDrop=false,moveRepeat=0;
let diceRollId=0;
let prepPhase=false,prepSelectedColumn=null,prepOrder=[],prepIndex=0,openingPlayer=BLUE;
let prepColumns={[BLUE]:null,[RED]:null};

function say(s){lastStatus=s;$("status").textContent=s}
function currentIsAI(){return mode==="ai"&&player===RED}
function other(p){return p===BLUE?RED:BLUE}
function colorName(p){return p===BLUE?"Blanco":"Negro"}
function cloneBoard(b){return b.map(row=>row.slice())}
function emptyBoard(){return Array.from({length:H},()=>Array(W).fill(0))}
function inBounds(x,y){return x>=0&&x<W&&y>=0&&y<H}
function neighbors(x,y){return [[x-1,y],[x+1,y],[x,y-1],[x,y+1]].filter(([a,b])=>inBounds(a,b))}
function groupsOf(b){
 const seen=Array.from({length:H},()=>Array(W).fill(false)),groups=[];
 for(let y=0;y<H;y++)for(let x=0;x<W;x++){
  if(!b[y][x]||seen[y][x])continue;
  const c=b[y][x],stack=[[x,y]],stones=[],lib=new Set();seen[y][x]=true;
  while(stack.length){
   const [a,d]=stack.pop();stones.push([a,d]);
   for(const [nx,ny] of neighbors(a,d)){
    if(!b[ny][nx])lib.add(ny*W+nx);
    else if(b[ny][nx]===c&&!seen[ny][nx]){seen[ny][nx]=true;stack.push([nx,ny])}
   }
  }
  groups.push({color:c,stones,liberties:lib.size});
 }
 return groups;
}
function settle(b){
 let captured=[0,0,0],changed=true,loops=0;
 while(changed&&loops++<H*W){
  changed=false;
  const groups=groupsOf(b),remove=[];
  for(const g of groups)if(g.liberties===0)remove.push(...g.stones.map(([x,y])=>[x,y,g.color]));
  if(remove.length){
   changed=true;
   for(const [x,y,c] of remove){if(b[y][x]===c){b[y][x]=0;captured[c]++}}
  }
  if(changed){
   for(let x=0;x<W;x++){
    const stack=[];
    for(let y=H-1;y>=0;y--)if(b[y][x])stack.push(b[y][x]);
    for(let y=H-1;y>=0;y--)b[y][x]=stack[H-1-y]||0;
   }
  }
 }
 return captured;
}
function tryPlacement(b,x,y,p){
 const next=cloneBoard(b);
 if(!inBounds(x,y)||next[y][x])return {ok:false};
 next[y][x]=p;
 const captured=settle(next);
 const own=groupsOf(next).filter(g=>g.color===p);
 if(own.some(g=>g.liberties===0))return {ok:false,suicide:true};
 return {ok:true,board:next,captured};
}
function canOccupy(x,y){return inBounds(x,y)&&!board[y][x]}
function landingY(b,x){
 if(b[0][x])return -1;
 let y=0;
 while(y+1<H&&!b[y+1][x])y++;
 return y;
}
function spawnPiece(){
 let col=-1;
 for(const x of SPAWN_ORDER)if(!board[0][x]){col=x;break}
 if(col<0){finishByScore("No quedan columnas disponibles.");return}
 piece={x:col,y:0};
 fallAccumulator=0;fastDrop=false;
 if(currentIsAI()){
  aiTarget=chooseAITarget();aiThink=0;
 }else aiTarget=null;
 say(currentIsAI()?"La IA está pensando...":("Turno de "+colorName(player)+". Mueve tu cubo."));
 render();
}
function evaluateBoard(b){
 const groups=groupsOf(b);
 let value=0;
 for(let y=0;y<H;y++)for(let x=0;x<W;x++){
  if(b[y][x]===RED)value+=1.1;
  else if(b[y][x]===BLUE)value-=1.1;
 }
 for(const g of groups){
  const sign=g.color===RED?1:-1;
  value+=sign*Math.min(g.liberties,4)*g.stones.length*.55;
  if(g.liberties===1){
   value-=sign*3.8*g.stones.length;
  }
 }
 return value;
}
function tacticalValue(b,captured,redExtra,blueExtra){
 let value=evaluateBoard(b);
 value+=(captured[BLUE]-captured[RED])*8;
 const redTotal=scores[RED]+(redExtra||0)+captured[BLUE]-captured[RED];
 const blueTotal=scores[BLUE]+(blueExtra||0)+captured[RED]-captured[BLUE];
 if(redTotal>=GOAL)return 100000;
 if(blueTotal>=GOAL)return -100000;
 return value;
}
function aiSearch(b,depth,turn,redScore,blueScore){
 if(redScore>=GOAL)return 100000+depth;
 if(blueScore>=GOAL)return -100000-depth;

 let best=turn===RED?-Infinity:Infinity;
 let found=false;

 for(let x=0;x<W;x++){
  const y=landingY(b,x);
  if(y<0)continue;

  const move=tryPlacement(b,x,y,turn);
  if(!move.ok)continue;
  found=true;

  const redGain=move.captured[BLUE]||0;
  const blueGain=move.captured[RED]||0;
  const gained=turn===RED?redGain:blueGain;
  const nextRed=redScore+redGain-blueGain;
  const nextBlue=blueScore+blueGain-redGain;

  let value;
  if(suddenDeath&&gained>0){
   value=turn===RED?100000+depth:-100000-depth;
  }else if(nextRed>=GOAL){
   value=100000+depth;
  }else if(nextBlue>=GOAL){
   value=-100000-depth;
  }else if(depth<=1){
   value=evaluateBoard(move.board)+(nextRed-nextBlue)*12;
  }else{
   value=aiSearch(
    move.board,depth-1,other(turn),nextRed,nextBlue
   );
  }

  if(turn===RED){
   if(value>best)best=value;
  }else{
   if(value<best)best=value;
  }
 }

 if(!found){
  if(redScore>blueScore)return 90000+depth;
  if(blueScore>redScore)return -90000-depth;
  return evaluateBoard(b)+(redScore-blueScore)*12;
 }
 return best;
}
function chooseAITarget(){
 const candidates=[];
 let bestValue=-Infinity;

 for(let x=0;x<W;x++){
  const y=landingY(board,x);
  if(y<0)continue;

  const move=tryPlacement(board,x,y,RED);
  if(!move.ok)continue;

  const redGain=move.captured[BLUE]||0;
  const blueGain=move.captured[RED]||0;
  const redScore=scores[RED]+redGain-blueGain;
  const blueScore=scores[BLUE]+blueGain-redGain;

  let value;
  if(redScore>=GOAL){
   value=100000;
  }else if(suddenDeath&&redGain>0){
   value=100000;
  }else if(blueScore>=GOAL){
   value=-100000;
  }else{
   value=aiSearch(
    move.board,2,BLUE,redScore,blueScore
   );
  }

  // Ligera preferencia por capturar sin sacrificar grupos propios.
  value+=(redGain-blueGain)*1.5;
  candidates.push({x,value});

  if(value>bestValue)bestValue=value;
 }

 if(!candidates.length){
  for(const x of SPAWN_ORDER){
   if(!board[0][x])return x;
  }
  return piece?piece.x:3;
 }

 // Normalmente elige la mejor jugada; ocasionalmente varía
 // entre alternativas cercanas para evitar un juego mecánico.
 const nearBest=candidates.filter(c=>c.value>=bestValue-2.5);
 if(nearBest.length>1&&Math.random()<0.14){
  const alternatives=nearBest.filter(c=>c.value<bestValue);
  if(alternatives.length){
   return alternatives[Math.floor(Math.random()*alternatives.length)].x;
  }
 }

 candidates.sort((a,b)=>b.value-a.value);
 return candidates[0].x;
}function prepAvailable(x){
 return Number.isInteger(x)&&x>=0&&x<W&&!Object.values(prepColumns).includes(x);
}
function prepSelect(x){
 if(!prepPhase||paused||gameOver||currentIsAI()||!prepAvailable(x))return;
 prepSelectedColumn=x;
 $("prep-confirm").disabled=false;
 say("Columna "+(x+1)+" seleccionada. Confirma tu ficha.");
 render();
}
function prepMove(dx){
 if(!prepPhase||paused||currentIsAI())return;
 let x=prepSelectedColumn===null?(dx>0?-1:W):prepSelectedColumn;
 for(let i=0;i<W;i++){
  x+=dx;if(x<0||x>=W)return;
  if(prepAvailable(x)){prepSelect(x);return;}
 }
}
function prepConfirm(){
 if(!prepPhase||paused||currentIsAI()||!prepAvailable(prepSelectedColumn))return;
 const p=player,x=prepSelectedColumn;
 board[H-1][x]=p;prepColumns[p]=x;prepSelectedColumn=null;prepIndex++;
 if(prepIndex>=prepOrder.length){
  prepPhase=false;
  $("prep-panel").style.display="none";
  say("Preparación completada. Comienza la partida.");
  beginTurn(openingPlayer);
  return;
 }
 player=prepOrder[prepIndex];
 say(currentIsAI()?"La IA prepara su ficha inicial.":"El segundo jugador: elige otra columna.");
 render();
 if(currentIsAI()){
  const col=SPAWN_ORDER.find(prepAvailable);
  if(col!==undefined){prepSelectedColumn=col;prepConfirmAI();}
 }
}
function prepConfirmAI(){
 if(!prepPhase||!currentIsAI()||!prepAvailable(prepSelectedColumn))return;
 const p=player,x=prepSelectedColumn;
 board[H-1][x]=p;prepColumns[p]=x;prepSelectedColumn=null;prepIndex++;
 if(prepIndex>=prepOrder.length){
  prepPhase=false;$("prep-panel").style.display="none";
  say("Preparación completada. Comienza la partida.");beginTurn(openingPlayer);return;
 }
 player=prepOrder[prepIndex];render();
 if(currentIsAI()){const col=SPAWN_ORDER.find(prepAvailable);if(col!==undefined){prepSelectedColumn=col;prepConfirmAI();}}
 else say("Elige una columna libre y confirma tu ficha inicial.");
}
function prepStart(winner){
 openingPlayer=winner;prepPhase=true;prepSelectedColumn=null;
 prepColumns={[BLUE]:null,[RED]:null};prepOrder=[winner,other(winner)];prepIndex=0;
 piece=null;player=prepOrder[0];paused=false;turnWait=0;fallAccumulator=0;aiTarget=null;fastDrop=false;
 $("pause").textContent="Pausar";
 $("prep-panel").style.display="flex";
 $("prep-confirm").disabled=true;
 say("El ganador de los dados elige primero su columna.");
 render();
 if(currentIsAI()){const col=SPAWN_ORDER.find(prepAvailable);if(col!==undefined){prepSelectedColumn=col;prepConfirmAI();}}
}
function movePiece(dx){
 if(!piece||gameOver||paused||currentIsAI())return;
 const nx=piece.x+dx;
 if(canOccupy(nx,piece.y)){piece.x=nx;render()}
}
function lockPiece(){
 if(!piece||gameOver)return;
 const x=piece.x,y=piece.y,p=player;
 const result=tryPlacement(board,x,y,p);
 piece=null;
 if(!result.ok){
  say(result.suicide?"Jugada anulada: suicidio prohibido. Turno perdido.":"Jugada no válida. Turno perdido.");
  turnWait=450;return;
 }
 board=result.board;
 const enemy=other(p);
 const gained=result.captured[enemy]||0;
 scores[p]+=gained;
 render();
 if(scores[p]>=GOAL){endGame(p,"¡"+colorName(p)+" alcanza las "+GOAL+" capturas!");return}
 if(suddenDeath&&gained>0){endGame(p,"¡Captura decisiva en muerte súbita!");return}
 if(gained>0)say(colorName(p)+" captura "+gained+" cubo"+(gained===1?"":"s")+".");
 else say("Cubo colocado. Sin capturas.");
 if(!hasAnySpawn()){
  finishByScore("El tablero está bloqueado.");
  return;
 }
 turnWait=550;
}
function hasAnySpawn(){return SPAWN_ORDER.some(x=>!board[0][x])}
function beginTurn(p){
 if(gameOver)return;
 player=p;piece=null;turnWait=0;fallAccumulator=0;aiTarget=null;
 spawnPiece();render();
}
function finishByScore(reason){
 if(scores[BLUE]>scores[RED])endGame(BLUE,reason+" Más capturas acumuladas.");
 else if(scores[RED]>scores[BLUE])endGame(RED,reason+" Más capturas acumuladas.");
 else if(reason.includes("bloqueado"))endGame(0,reason+" La puntuación está empatada.");
 else {suddenDeath=true;say("¡Muerte súbita! La siguiente captura decide la partida.");}
}
function endGame(winner,reason){
 gameOver=true;piece=null;paused=false;
 $("pause").textContent="Pausar";
 $("resultTitle").textContent=winner===0?"¡Tablas!":"¡Gana "+colorName(winner)+"!";
 $("resultText").textContent=reason+" Marcador final: Blanco "+scores[BLUE]+" — Negro "+scores[RED]+".";
 $("overlay").classList.add("show");
 say(reason);
 render();
}
function updateClock(){
 const n=Math.max(0,Math.ceil(remaining));
 $("time").textContent=String(Math.floor(n/60)).padStart(2,"0")+":"+String(n%60).padStart(2,"0");
 $("clock").classList.toggle("urgent",n<=60);
}
function render(){
 const el=$("board");el.replaceChildren();
 for(let y=0;y<H;y++)for(let x=0;x<W;x++){
  const cell=document.createElement("div");
  cell.className="cell"+(board[y][x]===BLUE?" blue":board[y][x]===RED?" red":"");
  if(piece&&piece.x===x&&piece.y===y)cell.classList.add("falling");
if(prepPhase&&y===H-1&&x===prepSelectedColumn&&prepAvailable(x))cell.classList.add("prep-preview");
  cell.setAttribute("aria-label",`Fila ${y+1}, columna ${x+1}`);
  cell.addEventListener("click",()=>{
   if(prepPhase){prepSelect(x);return;}
   if(!piece||gameOver||paused||currentIsAI())return;
   const dx=x-piece.x;
   if(dx)movePiece(Math.sign(dx));
  });
  el.appendChild(cell);
 }
 $("scoreBlue").textContent=scores[BLUE];
 $("scoreRed").textContent=scores[RED];
 $("pBlue").classList.toggle("active",!gameOver&&player===BLUE);
 $("pRed").classList.toggle("active",!gameOver&&player===RED);
 $("redName").textContent=mode==="ai"?"IA NEGRA":"JUGADOR NEGRO";
 $("left").disabled=!piece||paused||gameOver||currentIsAI();
 $("right").disabled=!piece||paused||gameOver||currentIsAI();
 $("down").disabled=prepPhase||!piece||paused||gameOver||currentIsAI();
if(prepPhase){
 $("prep-panel").style.display="flex";
 $("prep-confirm").disabled=paused||currentIsAI()||!prepAvailable(prepSelectedColumn);
 $("prep-title").textContent=prepSelectedColumn===null?"¿DÓNDE QUIERES EMPEZAR?":"¿AQUÍ? · COLUMNA "+(prepSelectedColumn+1);
 $("prep-help").textContent="Jugador "+(player===BLUE?"1 · BLANCAS":"2 · NEGRAS")+". Toca una columna o usa las flechas ← →. La ficha fantasma muestra dónde empezará. Cuando te guste, pulsa Confirmar ficha.";
}else{
 $("prep-panel").style.display="none";
}
 updateClock();
}
function startDiceRoll(){
 const overlay=$("dice-overlay");
 const face1=$("dice-face-1");
 const face2=$("dice-face-2");
 const status=$("dice-status");
 const name1=$("dice-name-1");
 const name2=$("dice-name-2");
 const rollId=++diceRollId;

 name1.textContent=mode==="ai"?"TÚ":"JUGADOR 1";
 name2.textContent=mode==="ai"?"IA":"JUGADOR 2";
 face1.textContent="⚄";
 face2.textContent="⚄";
 face1.classList.remove("rolling");
 face2.classList.remove("rolling");
 status.classList.remove("winner");
 status.textContent="¡Que empiece el duelo!";
 overlay.classList.add("show");

 function throwAgain(){
  if(rollId!==diceRollId)return;
  face1.classList.add("rolling");
  face2.classList.add("rolling");
  status.classList.remove("winner");
  status.textContent="Lanzando los dados...";
  const animation=setInterval(()=>{
   if(rollId!==diceRollId){clearInterval(animation);return;}
   face1.textContent=String(1+Math.floor(Math.random()*6));
   face2.textContent=String(1+Math.floor(Math.random()*6));
  },85);

  setTimeout(()=>{
   clearInterval(animation);
   if(rollId!==diceRollId)return;
   const a=1+Math.floor(Math.random()*6);
   const b=1+Math.floor(Math.random()*6);
   face1.textContent=String(a);
   face2.textContent=String(b);
   face1.classList.remove("rolling");
   face2.classList.remove("rolling");

   if(a===b){
    status.textContent="¡Empate! Repetimos el lanzamiento...";
    setTimeout(throwAgain,950);
    return;
   }

   const winner=a>b?BLUE:RED;
   const winnerName=mode==="ai"
    ?(winner===BLUE?"¡Empiezas tú!":"¡Empieza la IA!")
    :"¡Empieza el Jugador "+(winner===BLUE?"1":"2")+"!";
   status.textContent=winnerName;
   status.classList.add("winner");

   setTimeout(()=>{
    if(rollId!==diceRollId)return;
    overlay.classList.remove("show");
    paused=false;
    $("pause").textContent="Pausar";
    prepStart(winner);
    render();
   },1450);
  },1450);
 }
 throwAgain();
}

function showMainMenu(){
 diceRollId++;
 paused=true;
 prepPhase=false;
 fastDrop=false;
 $("dice-overlay").classList.remove("show");
 $("pause-overlay").classList.remove("show");
 $("overlay").classList.remove("show");
 $("prep-panel").style.display="none";
 $("main-menu").classList.add("show");
}
function launchFromMenu(selectedMode){
 $("mode").value=selectedMode;
 $("main-menu").classList.remove("show");
 resetGame();
}
function resetGame(){
 diceRollId++;
 board=emptyBoard();piece=null;player=BLUE;scores={[BLUE]:0,[RED]:0};
 mode=$("mode").value;remaining=MATCH_SECONDS;gameOver=false;paused=true;
 suddenDeath=false;turnWait=0;lastFrame=0;fallAccumulator=0;aiTarget=null;
 fastDrop=false;moveRepeat=0;
 $("overlay").classList.remove("show");$("pause").textContent="Pausar";
 say("Decidiendo quién empieza...");
 render();
 startDiceRoll();
}
function tick(now){
 requestAnimationFrame(tick);
 if(!lastFrame)lastFrame=now;
 const dt=Math.min((now-lastFrame)/1000,.1);lastFrame=now;
 if(gameOver||paused||prepPhase){return}
 if(!suddenDeath){
  remaining-=dt;
  if(remaining<=0){
   remaining=0;updateClock();
   if(scores[BLUE]===scores[RED]){
    suddenDeath=true;
    say("¡Tiempo! Empate a puntos. Muerte súbita: la siguiente captura gana.");
   }else{
    endGame(scores[BLUE]>scores[RED]?BLUE:RED,"Tiempo agotado.");
    return;
   }
  }
 }
 updateClock();
 if(turnWait>0){
  turnWait-=dt*1000;
  if(turnWait<=0&&!gameOver)beginTurn(other(player));
  return;
 }
 if(!piece||gameOver)return;
 if(currentIsAI()){
  aiThink+=dt;
  if(aiTarget!==null&&piece.x!==aiTarget&&aiThink>.11){
   aiThink=0;
   const dx=Math.sign(aiTarget-piece.x),nx=piece.x+dx;
   if(canOccupy(nx,piece.y))piece.x=nx;
   else aiTarget=piece.x;
   render();
  }
 }
 fallAccumulator+=dt;
 const interval=fastDrop?.045:(currentIsAI()?.40:.48);
 if(fallAccumulator>=interval){
  fallAccumulator=0;
  if(canOccupy(piece.x,piece.y+1)){piece.y++}
  else{lockPiece();return}
  render();
 }
}
function togglePause(){
 if(gameOver||$("dice-overlay").classList.contains("show"))return;
 paused=!paused;
 $("pause").textContent=paused?"Continuar":"Pausar";
 $("pause-overlay").classList.toggle("show",paused);
 fastDrop=false;
 say(paused?"Partida pausada.":(suddenDeath?"Muerte súbita: la siguiente captura decide.":lastStatus));
 render();
}
$("menu-ai").addEventListener("click",()=>launchFromMenu("ai"));
$("menu-local").addEventListener("click",()=>launchFromMenu("local"));
$("menu-online").addEventListener("click",()=>{window.location.href="online.html";});
$("to-menu").addEventListener("click",showMainMenu);
$("pause-continue").addEventListener("click",togglePause);
$("pause-to-menu").addEventListener("click",showMainMenu);
$("prep-confirm").addEventListener("click",prepConfirm);
$("left").addEventListener("click",()=>prepPhase?prepMove(-1):movePiece(-1));
$("right").addEventListener("click",()=>prepPhase?prepMove(1):movePiece(1));
$("down").addEventListener("pointerdown",()=>{if(!currentIsAI()&&!paused&&!gameOver)fastDrop=true});
["pointerup","pointercancel","pointerleave"].forEach(ev=>$("down").addEventListener(ev,()=>fastDrop=false));
$("new").addEventListener("click",resetGame);
$("again").addEventListener("click",resetGame);
$("pause").addEventListener("click",togglePause);
$("mode").addEventListener("change",resetGame);
document.addEventListener("keydown",e=>{
 const k=e.key.toLowerCase();
 if(["arrowleft","arrowright","arrowdown"," ","a","d","s"].includes(k))e.preventDefault();
 if(k==="p"&&!e.repeat){togglePause();return}
 if(e.repeat||!piece||gameOver||paused||currentIsAI())return;

 if(mode==="local"){
  if(player===BLUE){
   if(k==="arrowleft")movePiece(-1);
   if(k==="arrowright")movePiece(1);
   if(k==="arrowdown")fastDrop=true;
  }else{
   if(k==="a")movePiece(-1);
   if(k==="d")movePiece(1);
   if(k==="s")fastDrop=true;
  }
 }else{
  if(k==="arrowleft")movePiece(-1);
  if(k==="arrowright")movePiece(1);
  if(k==="arrowdown")fastDrop=true;
 }

 if(k===" "){fastDrop=false;lockPiece()}
});
document.addEventListener("keyup",e=>{
 const k=e.key.toLowerCase();
 if(k==="arrowdown"||k==="s")fastDrop=false;
});
resetGame();
requestAnimationFrame(tick);
</script>


<script>
/* GRAVITY_GO_LOCAL_BOARD_FIT_V1 */
(() => {
  const fitBoard = () => {
    if (window.matchMedia("(max-width: 680px)").matches) return;

    const wrap = document.querySelector(".boardwrap");
    const board = document.querySelector("#board");
    if (!wrap || !board) return;

    const gap = parseFloat(getComputedStyle(board).columnGap) || 2;
    const availableWidth = wrap.clientWidth - 4;
    const availableHeight = wrap.clientHeight - 4;

    if (availableWidth < 20 || availableHeight < 20) return;

    const cell = Math.floor(Math.min(
      (availableWidth - gap * 7) / 8,
      (availableHeight - gap * 11) / 12
    ));

    if (cell < 1) return;

    board.style.width = `${8 * cell + 7 * gap}px`;
    board.style.height = `${12 * cell + 11 * gap}px`;
    board.style.gridTemplateColumns = "repeat(8, minmax(0, 1fr))";
    board.style.gridTemplateRows = "repeat(12, minmax(0, 1fr))";
  };

  let pending = false;
  const scheduleFit = () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => {
      pending = false;
      fitBoard();
    });
  };

  const start = () => {
    const wrap = document.querySelector(".boardwrap");
    if (!wrap) return;

    if ("ResizeObserver" in window) {
      new ResizeObserver(scheduleFit).observe(wrap);
    }

    window.addEventListener("resize", scheduleFit);
    scheduleFit();
    requestAnimationFrame(() => requestAnimationFrame(scheduleFit));
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
})();
</script>
