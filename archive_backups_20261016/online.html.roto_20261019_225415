<script>
"use strict";

const W = 8, H = 12, BLUE = 1, RED = 2;
const $ = id => document.getElementById(id);

let socket = null;
let ownColor = 0;
let board = Array.from({length:H}, () => Array(W).fill(0));
let piece = null;
let remotePiece = null;
