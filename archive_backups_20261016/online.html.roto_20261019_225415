}

function boardKeyOf(b) {
  return b.map(row => row.join("")).join("/");
}

function updateClock() {
  const elapsed = phase === "playing" ? (Date.now() - stateReceivedAt) / 1000 : 0;
  const n = Math.max(0, Math.ceil(serverRemaining - elapsed));
  $("time").textContent =
    String(Math.floor(n/60)).padStart(2,"0") + ":" +
    String(n%60).padStart(2,"0");
  $("clock").classList.toggle("urgent", n <= 60 && phase === "playing");
}

function sendMessage(data) {
  if (!socket || socket.readyState !== WebSocket.OPEN) {
    say("No hay conexiÃƒÆ’Ã‚Â³n con el servidor.");
    return false;
  }
  socket.send(JSON.stringify(data));
  return true;
}

function canControl() {
  return gameStarted && !gameOver && phase === "playing" &&
    currentPlayer === ownColor && !!piece &&
    socket && socket.readyState === WebSocket.OPEN;
}

function sendControl(action) {
  if (!canControl()) return;
  sendMessage({type:"control", action});
}

function movePiece(dx) {
  if (!canControl()) return;
  sendControl(dx < 0 ? "left" : "right");
}

function chooseColumn(x) {
  if (!gameStarted || gameOver || phase !== "setup") return;
  if (setupPlayer !== ownColor || setupPlaced[ownColor]) {
    say("Espera a que te toque elegir la columna.");
    return;
  }
  sendMessage({type:"choose_column", x});
}

function render() {
  const el = $("board");
  el.replaceChildren();

  for (let y=0; y<H; y++) {
    for (let x=0; x<W; x++) {
      const cell = document.createElement("div");
      cell.className = "cell" +
        (board[y][x] === BLUE ? " blue" :
         board[y][x] === RED ? " red" : "");

      if (piece && piece.x === x && piece.y === y) {
        cell.classList.add("falling");
      }
      if (remotePiece && remotePiece.x === x && remotePiece.y === y) {
        cell.classList.add("remote-falling");
        cell.classList.add(remotePiece.color === BLUE ? "blue" : "red");
      }

      if (phase === "setup" && setupPlayer === ownColor &&
          !setupPlaced[ownColor] && y === H-1 && board[y][x] === 0) {
        cell.classList.add("selectable");
      }

      cell.setAttribute("aria-label", `Fila ${y+1}, columna ${x+1}`);
      cell.addEventListener("click", () => {
        if (phase === "setup") {
          chooseColumn(x);
          return;
        }
        if (canControl() && piece && x !== piece.x) {
          movePiece(Math.sign(x-piece.x));
        }
      });
      el.appendChild(cell);
    }
  }

  $("scoreBlue").textContent = scores[BLUE] || 0;
  $("scoreRed").textContent = scores[RED] || 0;
  $("pBlue").classList.toggle("active", !gameOver && currentPlayer === BLUE);
  $("pRed").classList.toggle("active", !gameOver && currentPlayer === RED);

  $("find").disabled = searching || connecting || gameStarted;
  $("cancel").disabled = !searching;
  $("rollDice").hidden = !(gameStarted && phase === "dice" &&
    diceRolls[ownColor] === null && !gameOver);
  $("rollDice").disabled = !socket || socket.readyState !== WebSocket.OPEN;
  $("rollDice").textContent = diceRound > 1
    ? "Volver a tirar los dados"
    : "Tirar los dados";
  $("surrender").hidden = !gameStarted || gameOver || phase === "over";
  $("left").disabled = !canControl();
  $("right").disabled = !canControl();
  $("down").disabled = !canControl();

  updateClock();
}

function handleState(data) {
  board = data.board || board;
  scores = data.scores || scores;
  currentPlayer = data.player || 0;
  phase = data.phase || phase;
  gameOver = !!data.gameOver;
  suddenDeath = !!data.suddenDeath;
  serverRemaining = Number.isFinite(data.remaining) ? data.remaining : serverRemaining;
  stateReceivedAt = Date.now();
  diceRolls = data.diceRolls || diceRolls;
  diceRound = data.diceRound || 1;
  setupPlaced = data.setupPlaced || setupPlaced;
  setupPlayer = data.setupPlayer || null;

  const active = data.activePiece &&
    Number.isInteger(data.activePiece.x) &&
    Number.isInteger(data.activePiece.y)
      ? {
          x:data.activePiece.x,
          y:data.activePiece.y,
          color:currentPlayer
        }
      : null;

  if (phase === "playing" && !gameOver) {
    if (currentPlayer === ownColor) {
      piece = active ? {x:active.x,y:active.y} : null;
      remotePiece = null;
    } else {
      piece = null;
      remotePiece = active;
    }
  } else {
    piece = null;
    remotePiece = null;
  }

  if (data.message) say(data.message);
  else if (phase === "dice") {
    const mine = diceRolls[ownColor];
    const theirs = diceRolls[other(ownColor)];
    if (mine !== null && theirs === null) {
      say(`Has sacado un ${mine}. Esperando el dado del rival...`);
    } else if (mine === null && theirs !== null) {
      say(`El rival ha sacado un ${theirs}. Te toca tirar.`);
    } else {
      say(diceRound > 1 ? "Empate. Volved a tirar los dados." : "Tirad los dados para decidir quiÃƒÆ’Ã‚Â©n empieza.");
    }
  } else if (phase === "setup") {
    if (setupPlayer === ownColor) {
      say("Te toca elegir una columna libre para tu cubo inicial.");
    } else {
      say("El rival estÃƒÆ’Ã‚Â¡ eligiendo su columna inicial.");
    }
  } else if (phase === "playing") {
    say(currentPlayer === ownColor
      ? (suddenDeath ? "Muerte sÃƒÆ’Ã‚Âºbita: la siguiente captura decide. Tu turno." : "Tu turno. Mueve tu cubo.")
      : "Turno del rival. Esperando su jugada...");
  }

  if (gameOver) {
    piece = null;
    remotePiece = null;
    const winner = data.winner;
    $("resultTitle").textContent =
      winner === 0 ? "Ãƒâ€šÃ‚Â¡Empate!" : "Ãƒâ€šÃ‚Â¡Gana " + colorName(winner) + "!";
    $("resultText").textContent =
      (data.reason || "Partida finalizada") +
      " Marcador final: Azul " + (scores[BLUE] || 0) +
      " ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â Rojo " + (scores[RED] || 0) + ".";
    $("overlay").classList.add("show");
  } else {
    $("overlay").classList.remove("show");
  }

  render();
}

function resetClient() {
  ownColor = 0;
  board = Array.from({length:H}, () => Array(W).fill(0));
  piece = null;
  remotePiece = null;
  currentPlayer = 0;
  scores = [0,0,0];
  gameStarted = false;
  gameOver = false;
  searching = false;
  connecting = false;
  phase = "idle";
  diceRolls = {[BLUE]:null,[RED]:null};
  diceRound = 1;
  setupPlaced = {[BLUE]:false,[RED]:false};
  setupPlayer = null;
  serverRemaining = 600;
  stateReceivedAt = Date.now();
  suddenDeath = false;
  render();
}

function connectAndFind() {
  if (gameStarted || searching || connecting) return;

  if (socket && socket.readyState === WebSocket.OPEN) {
    searching = true;
    sendMessage({type:"find"});
    say("Buscando rival...");
    render();
    return;
  }

  connecting = true;
  say("Conectando al servidor...");
  render();

  const protocol = location.protocol === "https:" ? "wss:" : "ws:";
  socket = new WebSocket(protocol + "//" + location.host + "/ws");

  socket.addEventListener("open", () => {
    connecting = false;
    searching = true;
    sendMessage({type:"find"});
    say("Buscando rival...");
    render();
  });

  socket.addEventListener("message", event => {
    let data;
    try {
      data = JSON.parse(event.data);
    } catch {
      say("Respuesta no vÃƒÆ’Ã‚Â¡lida del servidor.");
      return;
    }

    if (data.type === "searching") {
      searching = true;
      say("Buscando rival. Deja esta pÃƒÆ’Ã‚Â¡gina abierta...");
      render();
    } else if (data.type === "match_found") {
      searching = false;
      connecting = false;
      ownColor = data.color;
      gameStarted = true;
      gameOver = false;
      phase = "dice";
      piece = null;
      remotePiece = null;
      say("Ãƒâ€šÃ‚Â¡Rival encontrado! Preparando los dados...");
      render();
    } else if (data.type === "state") {
      if (!gameStarted && data.phase !== "idle") return;
      handleState(data);
    } else if (data.type === "piece_motion") {
      if (!gameStarted || gameOver || phase !== "playing") return;
      if (!Number.isInteger(data.x) || !Number.isInteger(data.y) ||
          data.x < 0 || data.x >= W || data.y < 0 || data.y >= H) return;

      if (data.color === ownColor) {
        piece = {x:data.x,y:data.y};
        remotePiece = null;
      } else {
        piece = null;
        remotePiece = {x:data.x,y:data.y,color:data.color};
      }
      render();
    } else if (data.type === "search_cancelled") {
      searching = false;
      say("BÃƒÆ’Ã‚Âºsqueda cancelada.");
      render();
    } else if (data.type === "error") {
      say(data.message || "Error del servidor.");
      render();
    } else if (data.type === "already_matched") {
      say("Ya estÃƒÆ’Ã‚Â¡s en una partida.");
    } else if (data.type === "pong") {
      // ConexiÃƒÆ’Ã‚Â³n activa.
    }
  });

  socket.addEventListener("close", () => {
    const wasPlaying = gameStarted;
    searching = false;
    connecting = false;
    gameStarted = false;
    gameOver = false;
    piece = null;
    remotePiece = null;
    phase = "idle";
    say(wasPlaying
      ? "ConexiÃƒÆ’Ã‚Â³n cerrada. La partida se ha interrumpido."
      : "ConexiÃƒÆ’Ã‚Â³n cerrada. Pulsa Buscar rival para volver a conectar.");
    render();
  });

  socket.addEventListener("error", () => {
    connecting = false;
    say("No se pudo conectar. Comprueba que el servidor estÃƒÆ’Ã‚Â© activo.");
    render();
  });
}

function cancelSearch() {
  if (!searching) return;
  sendMessage({type:"cancel_search"});
  searching = false;
  say("Cancelando bÃƒÆ’Ã‚Âºsqueda...");
  render();
}

function beginDownInput() {
  if (downInputActive || !canControl()) return;
  downInputActive = true;
  downHoldActive = false;
  downHoldTimer = setTimeout(() => {
    downHoldTimer = null;
    if (!downInputActive) return;
    downHoldActive = true;
    sendControl("down_start");
  }, 140);
}

function endDownInput() {
  if (!downInputActive) return;
  downInputActive = false;

  if (downHoldTimer !== null) {
    clearTimeout(downHoldTimer);
    downHoldTimer = null;
  }

  if (downHoldActive) sendControl("down_stop");
  else sendControl("down_step");

  downHoldActive = false;
}

$("find").addEventListener("click", connectAndFind);
$("cancel").addEventListener("click", cancelSearch);

$("rollDice").addEventListener("click", () => {
  if (!gameStarted || phase !== "dice" || diceRolls[ownColor] !== null) return;
  sendMessage({type:"roll_dice"});
  say("Has lanzado el dado. Esperando el resultado...");
  $("rollDice").disabled = true;
});

$("surrender").addEventListener("click", () => {
  if (!gameStarted || gameOver) return;
  if (window.confirm("Ãƒâ€šÃ‚Â¿Seguro que quieres rendirte? El rival ganarÃƒÆ’Ã‚Â¡ la partida.")) {
    sendMessage({type:"surrender"});
    say("Has solicitado la rendiciÃƒÆ’Ã‚Â³n...");
    $("surrender").disabled = true;
  }
});

$("left").addEventListener("click", () => movePiece(-1));
$("right").addEventListener("click", () => movePiece(1));

const downButton = $("down");
downButton.addEventListener("pointerdown", event => {
  event.preventDefault();
  if (downButton.setPointerCapture) {
    try { downButton.setPointerCapture(event.pointerId); } catch {}
  }
  beginDownInput();
});
["pointerup","pointercancel","lostpointercapture"].forEach(name => {
  downButton.addEventListener(name, endDownInput);
});

$("to-menu").addEventListener("click", () => {
  window.location.href = "index.html";
});

$("again").addEventListener("click", () => {
  $("overlay").classList.remove("show");
  resetClient();
  connectAndFind();
});

document.addEventListener("keydown", event => {
  if (["ArrowLeft","ArrowRight","ArrowDown"," "].includes(event.key)) {
    event.preventDefault();
  }
  if (event.repeat) return;
  if (event.key === "ArrowLeft") movePiece(-1);
  if (event.key === "ArrowRight") movePiece(1);
  if (event.key === "ArrowDown") beginDownInput();
});

document.addEventListener("keyup", event => {
  if (event.key === "ArrowDown") endDownInput();
});
window.addEventListener("blur", endDownInput);

setInterval(updateClock, 250);

setInterval(() => {
  if (socket && socket.readyState === WebSocket.OPEN) {
    sendMessage({type:"ping"});
  }
}, 1500);

render();
</script>
<script>
/* GRAVITY_GO_AUTO_BOARD_HEIGHT_V3 */
(() => {
  function fitGravityBoard() {
    if (window.matchMedia("(max-width: 680px)").matches) return;

    const board = document.getElementById("board");
    const wrap = document.querySelector(".boardwrap");
    const layout = document.querySelector(".layout");
    const main = document.querySelector("main");
    if (!board || !wrap || !layout || !main) return;

    const wrapRect = wrap.getBoundingClientRect();
    const availableWidth = Math.max(0, wrap.clientWidth - 8);
    const availableHeight = Math.max(
      0,
      window.innerHeight - wrapRect.top - 38
    );

    const gap = 2;
    const cell = Math.floor(Math.max(0, Math.min(
      (availableWidth - gap * 7) / 8,
      (availableHeight - gap * 11) / 12
    )));

    if (cell < 1) return;

    board.style.setProperty("width", (cell * 8 + gap * 7) + "px", "important");
    board.style.setProperty("height", (cell * 12 + gap * 11) + "px", "important");
    board.style.setProperty("grid-template-columns", "repeat(8, minmax(0, 1fr))", "important");
    board.style.setProperty("grid-template-rows", "repeat(12, minmax(0, 1fr))", "important");
  }

  let pending = false;
  function scheduleFit() {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => {
      pending = false;
      fitGravityBoard();
    });
  }

  window.addEventListener("resize", scheduleFit);
  window.addEventListener("load", scheduleFit);
  document.addEventListener("DOMContentLoaded", scheduleFit);

  if (window.ResizeObserver) {
    const observer = new ResizeObserver(scheduleFit);
    window.addEventListener("load", () => {
      const wrap = document.querySelector(".boardwrap");
      if (wrap) observer.observe(wrap);
    });
  }

  scheduleFit();
})();
</script>

