
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>GRAVITY GO — ONLINE</title>
<style>
:root{color-scheme:dark;--bg:#090d15;--panel:#111927;--line:#29354a;--blue:#39a9ff;--red:#ff5269;--text:#f0f5ff;--muted:#9ba9bf;--gold:#ffd166}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at top,#17243a 0,#090d15 65%);color:var(--text);font-family:Segoe UI,Arial,sans-serif;min-height:100vh}
button{font:inherit;border:1px solid #34435a;background:#1b293d;color:var(--text);border-radius:10px;padding:11px 15px;cursor:pointer;touch-action:manipulation}
button:hover:not(:disabled){background:#263951}
button:disabled{opacity:.4;cursor:default}
header{text-align:center;padding:18px 10px 8px}
.logo{font-weight:950;font-size:clamp(27px,5vw,43px);letter-spacing:5px}
.logo span{color:var(--blue)}
.sub{color:var(--muted);font-size:12px;letter-spacing:2px;margin-top:4px}
main{width:min(1050px,100%);margin:auto;padding:10px 14px 25px}
.topbar{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:stretch;margin-bottom:12px}
.player{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:12px;min-width:0}
.player.red{text-align:right}
.player.active{border-color:var(--gold);box-shadow:0 0 0 1px #ffd16630}
.pname{font-size:12px;letter-spacing:2px;color:var(--muted)}
.score{font-size:clamp(25px,5vw,38px);font-weight:900;line-height:1.25}
.blue .score{color:#fff}.red .score{color:#aeb5c0}
.target{font-size:11px;color:var(--muted)}
.clock{background:#101827;border:1px solid var(--line);border-radius:13px;min-width:108px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:8px 12px}
.clock strong{font-size:clamp(23px,4vw,32px);font-variant-numeric:tabular-nums}
.clock small{color:var(--muted);font-size:10px;letter-spacing:1px}
.clock.urgent strong{color:var(--red)}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 235px;gap:14px;align-items:start}
.boardwrap{background:#0d1420;border:1px solid var(--line);border-radius:14px;padding:10px;min-width:0}
#board{width:100%;display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:4px;touch-action:manipulation}
.cell{aspect-ratio:1;border-radius:4px;background:#182437;border:1px solid #29374d;position:relative;min-width:0}
.cell::after{content:"";position:absolute;inset:15%;border-radius:3px;opacity:0;pointer-events:none}
.cell.blue::after,.cell.red::after{opacity:1}
.cell.blue::after{background:#f5f5f5;border:1px solid #fff;box-shadow:0 0 7px #ffffff35}
.cell.red::after{background:#080a0e;border:1px solid #d8dce4;box-shadow:inset 0 0 0 1px #000}
.cell.falling{outline:2px solid white;outline-offset:-2px}
.cell.remote-falling{outline:2px solid var(--gold);outline-offset:-2px}
.cell.selectable{cursor:pointer;background:#243a50}
.cell.selectable:hover{border-color:var(--gold);box-shadow:inset 0 0 0 2px #ffd16670}
.side{display:flex;flex-direction:column;gap:12px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:14px}
.card h3{font-size:12px;letter-spacing:2px;margin:0 0 11px;color:var(--muted)}
.status{font-size:14px;line-height:1.5;min-height:45px;overflow-wrap:anywhere}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.actions button{padding:10px 6px}
.primary{background:#174b77;border-color:#277fbd}
.danger{background:#55212c;border-color:#9e3448}
.rules{font-size:12px;line-height:1.65;color:var(--muted)}
.rules b{color:var(--text)}
.controls{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:10px}
.controls button{font-size:18px;padding:12px 4px;user-select:none}
.hint{text-align:center;color:var(--muted);font-size:11px;margin:10px 0 2px}
#phaseActions{display:grid;gap:8px;margin-top:10px}
#phaseActions button{width:100%}
#overlay{position:fixed;inset:0;background:#050810d9;display:none;align-items:center;justify-content:center;padding:20px;z-index:5}
#overlay.show{display:flex}
.modal{width:min(400px,100%);background:#111927;border:1px solid #42516a;border-radius:18px;padding:25px;text-align:center;box-shadow:0 20px 80px #0009}
.modal h2{font-size:27px;margin:0 0 10px}
.modal p{color:var(--muted);line-height:1.5}
.modal button{margin-top:10px}
.modal .menu-return{background:#111927;border-color:#42516a}
@media(max-width:680px){
 main{padding:7px 9px 18px}
 .layout{grid-template-columns:1fr}
 .side{display:grid;grid-template-columns:1fr 1fr}
 .side .rulescard{grid-column:1/-1}
 .boardwrap{padding:7px}
 #board{gap:3px}
 .cell{border-radius:3px}
 .topbar{gap:5px}
 .player{padding:9px}
 .clock{min-width:83px;padding:6px}
 .controls button{padding:14px 4px}
}
</style>
</head>
<body>
<header>
  <div class="logo">GRAVITY <span>GO</span></div>
  <div class="sub">ONLINE MULTIPLAYER · STRATEGY MEETS GRAVITY</div>
</header>

<main>
  <section class="topbar">
    <div id="pBlue" class="player blue">
      <div class="pname">JUGADOR 1</div>
      <div class="score" id="scoreBlue">0</div>
      <div class="target">OBJETIVO: 20 CAPTURAS</div>
    </div>
    <div class="clock" id="clock">
      <small>TIEMPO</small>
      <strong id="time">10:00</strong>
      <small>POR PARTIDA</small>
    </div>
    <div id="pRed" class="player red">
      <div class="pname">JUGADOR 2</div>
      <div class="score" id="scoreRed">0</div>
      <div class="target">OBJETIVO: 20 CAPTURAS</div>
    </div>
  </section>

  <section class="layout">
    <div>
      <div class="boardwrap">
        <div id="board" aria-label="Tablero de Gravity Go"></div>
      </div>

      <div class="controls">
        <button id="left" aria-label="Mover a la izquierda" disabled>←</button>
        <button id="down" aria-label="Acelerar caída" disabled>↓ Acelerar</button>
        <button id="right" aria-label="Mover a la derecha" disabled>→</button>
      </div>
      <div class="hint">← → mover · ↓ acelerar · Pulsa una columna durante la colocación inicial</div>
    </div>

    <aside class="side">
      <div class="card">
        <h3>PARTIDA</h3>
        <div class="actions">
          <button id="find" class="primary">Buscar rival</button>
          <button id="cancel" disabled>Cancelar búsqueda</button>
        </div>
        <div id="phaseActions">
          <button id="rollDice" class="primary" hidden>Tirar los dados</button>
          <button id="surrender" class="danger" hidden>Rendirse</button>
        </div>
      </div>

      <div class="card">
        <h3>ESTADO</h3>
        <div class="status" id="status" aria-live="polite">Pulsa «Buscar rival» para encontrar una partida.</div>
      </div>

      <div class="card rulescard">
        <h3>REGLAS DE VICTORIA</h3>
        <div class="rules">
          <b>Dados:</b> ambos jugadores tiran un dado; el resultado más alto empieza. Si hay empate, se repite.<br>
          <b>Colocación inicial:</b> cada jugador elige una columna distinta.<br>
          <b>20 capturas:</b> victoria inmediata.<br>
          <b>10 minutos:</b> gana quien tenga más capturas.<br>
          <b>Empate:</b> muerte súbita; la siguiente captura decide.<br>
          <b>Gravedad:</b> los grupos sin libertades desaparecen y los cubos supervivientes caen.
        </div>
      </div>
    </aside>
  </section>
</main>

<div id="overlay">
  <div class="modal">
    <h2 id="resultTitle">Fin de partida</h2>
    <p id="resultText"></p>
    <button id="again" class="primary">Jugar otra vez</button>
    <button id="to-menu" class="menu-return">Menú principal</button>
  </div>
</div>

<script>
"use strict";

const W = 8, H = 12, BLUE = 1, RED = 2;
const $ = id => document.getElementById(id);

let socket = null;
let ownColor = 0;
let board = Array.from({length:H}, () => Array(W).fill(0));
let piece = null;
let remotePiece = null;
let currentPlayer = 0;
let scores = [0,0,0];
let gameStarted = false;
let gameOver = false;
let searching = false;
let connecting = false;
let phase = "idle";
let diceRolls = {[BLUE]:null,[RED]:null};
let diceRound = 1;
let setupPlaced = {[BLUE]:false,[RED]:false};
let setupPlayer = null;
let serverRemaining = 600;
let stateReceivedAt = Date.now();
let suddenDeath = false;
let lastMessage = "Pulsa «Buscar rival» para encontrar una partida.";
let downInputActive = false;
let downHoldActive = false;
let downHoldTimer = null;

function say(message) {
  if (!message) return;
  lastMessage = message;
  $("status").textContent = message;
}

function colorName(player) {
  return player === BLUE ? "Azul" : "Rojo";
}

function other(player) {
  return player === BLUE ? RED : BLUE;
}

function boardKeyOf(b) {
  return b.map(row => row.join("")).join("/");
}

function updateClock() {
  const elapsed = phase === "playing" ? (Date.now() - stateReceivedAt) / 1000 : 0;
  const n = Math.max(0, Math.ceil(serverRemaining - elapsed));
  $("time").textContent =
    String(Math.floor(n/60)).padStart(2,"0") + ":" +
    String(n%60).padStart(2,"0");
  $("clock").classList.toggle("urgent", n <= 60 && phase === "playing");
}

function sendMessage(data) {
  if (!socket || socket.readyState !== WebSocket.OPEN) {
    say("No hay conexión con el servidor.");
    return false;
  }
  socket.send(JSON.stringify(data));
  return true;
}

function canControl() {
  return gameStarted && !gameOver && phase === "playing" &&
    currentPlayer === ownColor && !!piece &&
    socket && socket.readyState === WebSocket.OPEN;
}

function sendControl(action) {
  if (!canControl()) return;
  sendMessage({type:"control", action});
}

function movePiece(dx) {
  if (!canControl()) return;
  sendControl(dx < 0 ? "left" : "right");
}

function chooseColumn(x) {
  if (!gameStarted || gameOver || phase !== "setup") return;
  if (setupPlayer !== ownColor || setupPlaced[ownColor]) {
    say("Espera a que te toque elegir la columna.");
    return;
  }
  sendMessage({type:"choose_column", x});
}

function render() {
  const el = $("board");
  el.replaceChildren();

  for (let y=0; y<H; y++) {
    for (let x=0; x<W; x++) {
      const cell = document.createElement("div");
      cell.className = "cell" +
        (board[y][x] === BLUE ? " blue" :
         board[y][x] === RED ? " red" : "");

      if (piece && piece.x === x && piece.y === y) {
        cell.classList.add("falling");
      }
      if (remotePiece && remotePiece.x === x && remotePiece.y === y) {
        cell.classList.add("remote-falling");
        cell.classList.add(remotePiece.color === BLUE ? "blue" : "red");
      }

      if (phase === "setup" && setupPlayer === ownColor &&
          !setupPlaced[ownColor] && y === H-1 && board[y][x] === 0) {
        cell.classList.add("selectable");
      }

      cell.setAttribute("aria-label", `Fila ${y+1}, columna ${x+1}`);
      cell.addEventListener("click", () => {
        if (phase === "setup") {
          chooseColumn(x);
          return;
        }
        if (canControl() && piece && x !== piece.x) {
          movePiece(Math.sign(x-piece.x));
        }
      });
      el.appendChild(cell);
    }
  }

  $("scoreBlue").textContent = scores[BLUE] || 0;
  $("scoreRed").textContent = scores[RED] || 0;
  $("pBlue").classList.toggle("active", !gameOver && currentPlayer === BLUE);
  $("pRed").classList.toggle("active", !gameOver && currentPlayer === RED);

  $("find").disabled = searching || connecting || gameStarted;
  $("cancel").disabled = !searching;
  $("rollDice").hidden = !(gameStarted && phase === "dice" &&
    diceRolls[ownColor] === null && !gameOver);
  $("rollDice").disabled = !socket || socket.readyState !== WebSocket.OPEN;
  $("rollDice").textContent = diceRound > 1
    ? "Volver a tirar los dados"
    : "Tirar los dados";
  $("surrender").hidden = !gameStarted || gameOver || phase === "over";
  $("left").disabled = !canControl();
  $("right").disabled = !canControl();
  $("down").disabled = !canControl();

  updateClock();
}

function handleState(data) {
  board = data.board || board;
  scores = data.scores || scores;
  currentPlayer = data.player || 0;
  phase = data.phase || phase;
  gameOver = !!data.gameOver;
  suddenDeath = !!data.suddenDeath;
  serverRemaining = Number.isFinite(data.remaining) ? data.remaining : serverRemaining;
  stateReceivedAt = Date.now();
  diceRolls = data.diceRolls || diceRolls;
  diceRound = data.diceRound || 1;
  setupPlaced = data.setupPlaced || setupPlaced;
  setupPlayer = data.setupPlayer || null;

  const active = data.activePiece &&
    Number.isInteger(data.activePiece.x) &&
    Number.isInteger(data.activePiece.y)
      ? {
          x:data.activePiece.x,
          y:data.activePiece.y,
          color:currentPlayer
        }
      : null;

  if (phase === "playing" && !gameOver) {
    if (currentPlayer === ownColor) {
      piece = active ? {x:active.x,y:active.y} : null;
      remotePiece = null;
    } else {
      piece = null;
      remotePiece = active;
    }
  } else {
    piece = null;
    remotePiece = null;
  }

  if (data.message) say(data.message);
  else if (phase === "dice") {
    const mine = diceRolls[ownColor];
    const theirs = diceRolls[other(ownColor)];
    if (mine !== null && theirs === null) {
      say(`Has sacado un ${mine}. Esperando el dado del rival...`);
    } else if (mine === null && theirs !== null) {
      say(`El rival ha sacado un ${theirs}. Te toca tirar.`);
    } else {
      say(diceRound > 1 ? "Empate. Volved a tirar los dados." : "Tirad los dados para decidir quién empieza.");
    }
  } else if (phase === "setup") {
    if (setupPlayer === ownColor) {
      say("Te toca elegir una columna libre para tu cubo inicial.");
    } else {
      say("El rival está eligiendo su columna inicial.");
    }
  } else if (phase === "playing") {
    say(currentPlayer === ownColor
      ? (suddenDeath ? "Muerte súbita: la siguiente captura decide. Tu turno." : "Tu turno. Mueve tu cubo.")
      : "Turno del rival. Esperando su jugada...");
  }

  if (gameOver) {
    piece = null;
    remotePiece = null;
    const winner = data.winner;
    $("resultTitle").textContent =
      winner === 0 ? "¡Empate!" : "¡Gana " + colorName(winner) + "!";
    $("resultText").textContent =
      (data.reason || "Partida finalizada") +
      " Marcador final: Azul " + (scores[BLUE] || 0) +
      " — Rojo " + (scores[RED] || 0) + ".";
    $("overlay").classList.add("show");
  } else {
    $("overlay").classList.remove("show");
  }

  render();
}

function resetClient() {
  ownColor = 0;
  board = Array.from({length:H}, () => Array(W).fill(0));
  piece = null;
  remotePiece = null;
  currentPlayer = 0;
  scores = [0,0,0];
  gameStarted = false;
  gameOver = false;
  searching = false;
  connecting = false;
  phase = "idle";
  diceRolls = {[BLUE]:null,[RED]:null};
  diceRound = 1;
  setupPlaced = {[BLUE]:false,[RED]:false};
  setupPlayer = null;
  serverRemaining = 600;
  stateReceivedAt = Date.now();
  suddenDeath = false;
  render();
}

function connectAndFind() {
  if (gameStarted || searching || connecting) return;

  if (socket && socket.readyState === WebSocket.OPEN) {
    searching = true;
    sendMessage({type:"find"});
    say("Buscando rival...");
    render();
    return;
  }

  connecting = true;
  say("Conectando al servidor...");
  render();

  const protocol = location.protocol === "https:" ? "wss:" : "ws:";
  socket = new WebSocket(protocol + "//" + location.host + "/ws");

  socket.addEventListener("open", () => {
    connecting = false;
    searching = true;
    sendMessage({type:"find"});
    say("Buscando rival...");
    render();
  });

  socket.addEventListener("message", event => {
    let data;
    try {
      data = JSON.parse(event.data);
    } catch {
      say("Respuesta no válida del servidor.");
      return;
    }

    if (data.type === "searching") {
      searching = true;
      say("Buscando rival. Deja esta página abierta...");
      render();
    } else if (data.type === "match_found") {
      searching = false;
      connecting = false;
      ownColor = data.color;
      gameStarted = true;
      gameOver = false;
      phase = "dice";
      piece = null;
      remotePiece = null;
      say("¡Rival encontrado! Preparando los dados...");
      render();
    } else if (data.type === "state") {
      if (!gameStarted && data.phase !== "idle") return;
      handleState(data);
    } else if (data.type === "piece_motion") {
      if (!gameStarted || gameOver || phase !== "playing") return;
      if (!Number.isInteger(data.x) || !Number.isInteger(data.y) ||
          data.x < 0 || data.x >= W || data.y < 0 || data.y >= H) return;

      if (data.color === ownColor) {
        piece = {x:data.x,y:data.y};
        remotePiece = null;
      } else {
        piece = null;
        remotePiece = {x:data.x,y:data.y,color:data.color};
      }
      render();
    } else if (data.type === "search_cancelled") {
      searching = false;
      say("Búsqueda cancelada.");
      render();
    } else if (data.type === "error") {
      say(data.message || "Error del servidor.");
      render();
    } else if (data.type === "already_matched") {
      say("Ya estás en una partida.");
    } else if (data.type === "pong") {
      // Conexión activa.
    }
  });

  socket.addEventListener("close", () => {
    const wasPlaying = gameStarted;
    searching = false;
    connecting = false;
    gameStarted = false;
    gameOver = false;
    piece = null;
    remotePiece = null;
    phase = "idle";
    say(wasPlaying
      ? "Conexión cerrada. La partida se ha interrumpido."
      : "Conexión cerrada. Pulsa Buscar rival para volver a conectar.");
    render();
  });

  socket.addEventListener("error", () => {
    connecting = false;
    say("No se pudo conectar. Comprueba que el servidor esté activo.");
    render();
  });
}

function cancelSearch() {
  if (!searching) return;
  sendMessage({type:"cancel_search"});
  searching = false;
  say("Cancelando búsqueda...");
  render();
}

function beginDownInput() {
  if (downInputActive || !canControl()) return;
  downInputActive = true;
  downHoldActive = false;
  downHoldTimer = setTimeout(() => {
    downHoldTimer = null;
    if (!downInputActive) return;
    downHoldActive = true;
    sendControl("down_start");
  }, 140);
}

function endDownInput() {
  if (!downInputActive) return;
  downInputActive = false;

  if (downHoldTimer !== null) {
    clearTimeout(downHoldTimer);
    downHoldTimer = null;
  }

  if (downHoldActive) sendControl("down_stop");
  else sendControl("down_step");

  downHoldActive = false;
}

$("find").addEventListener("click", connectAndFind);
$("cancel").addEventListener("click", cancelSearch);

$("rollDice").addEventListener("click", () => {
  if (!gameStarted || phase !== "dice" || diceRolls[ownColor] !== null) return;
  sendMessage({type:"roll_dice"});
  say("Has lanzado el dado. Esperando el resultado...");
  $("rollDice").disabled = true;
});

$("surrender").addEventListener("click", () => {
  if (!gameStarted || gameOver) return;
  if (window.confirm("¿Seguro que quieres rendirte? El rival ganará la partida.")) {
    sendMessage({type:"surrender"});
    say("Has solicitado la rendición...");
    $("surrender").disabled = true;
  }
});

$("left").addEventListener("click", () => movePiece(-1));
$("right").addEventListener("click", () => movePiece(1));

const downButton = $("down");
downButton.addEventListener("pointerdown", event => {
  event.preventDefault();
  if (downButton.setPointerCapture) {
    try { downButton.setPointerCapture(event.pointerId); } catch {}
  }
  beginDownInput();
});
["pointerup","pointercancel","lostpointercapture"].forEach(name => {
  downButton.addEventListener(name, endDownInput);
});

$("to-menu").addEventListener("click", () => {
  window.location.href = "index.html";
});

$("again").addEventListener("click", () => {
  $("overlay").classList.remove("show");
  resetClient();
  connectAndFind();
});

document.addEventListener("keydown", event => {
  if (["ArrowLeft","ArrowRight","ArrowDown"," "].includes(event.key)) {
    event.preventDefault();
  }
  if (event.repeat) return;
  if (event.key === "ArrowLeft") movePiece(-1);
  if (event.key === "ArrowRight") movePiece(1);
  if (event.key === "ArrowDown") beginDownInput();
});

document.addEventListener("keyup", event => {
  if (event.key === "ArrowDown") endDownInput();
});
window.addEventListener("blur", endDownInput);

setInterval(updateClock, 250);

setInterval(() => {
  if (socket && socket.readyState === WebSocket.OPEN) {
    sendMessage({type:"ping"});
  }
}, 1500);

render();
</script>
</body>
</html>
