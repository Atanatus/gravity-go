<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>GRAVITY GO ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â v0.1</title>
<style>
:root{color-scheme:dark;--bg:#090d15;--panel:#111927;--line:#29354a;--text:#f0f5ff;--muted:#9ba9bf;--gold:#ffd166}
*{box-sizing:border-box}
html,body{height:100%;height:100dvh;margin:0;overflow:hidden}
body{display:flex;flex-direction:column;background:radial-gradient(ellipse at top,#17243a 0,#090d15 65%);color:var(--text);font-family:Segoe UI,Arial,sans-serif}
button{border:1px solid #34435a;background:#1b293d;color:var(--text);border-radius:8px;padding:8px 12px;cursor:pointer;font:inherit}
button:hover{background:#263951}
button:disabled{opacity:.45}
header{position:relative;flex:0 0 auto;padding:6px 12px 4px;text-align:center}
.logo{font-weight:900;font-size:clamp(22px,3.2vw,34px);letter-spacing:3px}
.sub{color:var(--muted);font-size:10px;letter-spacing:2px;margin-top:1px}
.header-actions{position:absolute;top:8px;right:12px}
.header-actions button{height:30px;padding:4px 10px;font-size:13px}
main{flex:1 1 0;min-height:0;display:flex;flex-direction:column;padding:6px 10px 8px;overflow:hidden}
.topbar{display:grid;grid-template-columns:1fr auto 1fr;gap:6px;margin-bottom:2px;flex:0 0 auto}
.player{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:4px 8px}
.player.red{text-align:right}
.player.active{border-color:var(--gold)}
.pname{font-size:11px;letter-spacing:1px;color:var(--muted)}
.score{font-size:clamp(20px,2.8vw,30px);font-weight:900;line-height:1}
.target{font-size:10px;color:var(--muted)}
.clock{background:#101827;border:1px solid var(--line);border-radius:10px;min-width:78px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:4px 6px}
.clock strong{font-size:clamp(18px,2.4vw,26px);font-variant-numeric:tabular-nums}
.clock small{font-size:8px;color:var(--muted)}
.layout{flex:1 1 0;min-height:0;display:flex;flex-direction:column}
.layout>div:first-child{flex:1 1 0;min-height:0;display:grid;grid-template-rows:minmax(0,1fr) auto;gap:6px}
.boardwrap{grid-row:1;min-height:0;display:flex;align-items:center;justify-content:center;background:#0d1420;border:1px solid var(--line);border-radius:12px;padding:6px}

.cell{aspect-ratio:1;background:#182437;border:1px solid #29374d;border-radius:3px;position:relative}
.cell.blue::after,.cell.red::after{content:"";position:absolute;inset:12%;border-radius:2px}
.cell.blue::after{background:#f5f5f5}
.cell.red::after{background:#080a0e;border:1px solid #d8dce4}
.cell.falling{outline:2px solid #fff;outline-offset:-2px}
.cell.prep-preview{outline:2px dashed var(--gold);outline-offset:-3px;background:rgba(255,209,102,.12)}
#prep-panel,.card{grid-row:2;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:6px 10px}
#prep-panel[style*="display:flex"]~.card{display:none!important}
#prep-title{color:var(--gold);font-size:12px;margin:0 0 2px}
#prep-help{font-size:11px;margin:0 0 4px}
#prep-confirm{min-height:28px;padding:4px 10px}
.card h3{font-size:10px;letter-spacing:1px;color:var(--muted);margin:0 0 3px}
.status{font-size:12px}
.controls{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-top:4px}
.controls button{height:28px;padding:2px;font-size:14px}
.hint{text-align:center;color:var(--muted);font-size:10px;margin:3px 0 0}
.primary{background:#174b77;border-color:#277fbd}
#overlay{position:fixed;inset:0;background:#050810d9;display:none;align-items:center;justify-content:center;z-index:5;padding:20px}
#overlay.show{display:flex}
.modal{width:min(400px,100%);background:#111927;border:1px solid #42516a;border-radius:16px;padding:24px;text-align:center}
#pause-overlay{position:fixed;inset:0;z-index:9000;display:none;align-items:center;justify-content:center;background:#050810e8;backdrop-filter:blur(4px)}
#pause-overlay.show{display:flex}
.pause-modal{width:min(380px,100%);padding:24px;text-align:center;background:#111927;border:1px solid #42516a;border-radius:16px}
.pause-actions{display:grid;gap:8px;margin-top:16px}
.pause-actions button{min-height:44px}
#main-menu{position:fixed;inset:0;z-index:20000;display:none;align-items:center;justify-content:center;background:radial-gradient(ellipse at 50% 15%,#203653 0,#0a101b 55%,#05080e 100%);padding:20px}
#main-menu.show{display:flex}
.menu-inner{width:min(480px,100%);text-align:center}
.menu-brand{font-size:clamp(32px,8vw,56px);font-weight:900;letter-spacing:4px}
.menu-brand span{color:var(--gold)}
.menu-options{display:grid;gap:10px;margin-top:24px}
.menu-option{display:flex;align-items:center;gap:12px;padding:14px;background:#17263a;border:1px solid #34445b;border-radius:12px;text-align:left}
.menu-option.primary{background:#174b77;border-color:#3989bd}
.dice-overlay{position:fixed;inset:0;z-index:10000;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.94);color:#fff}
.dice-overlay.show{display:flex}
.dice-panel{text-align:center;width:min(500px,100%)}
.dice-face{width:90px;height:90px;border:2px solid #fff;border-radius:16px;display:grid;place-items:center;font-size:48px;font-weight:900;background:#fff;color:#000;margin:8px auto}

/* FIX PANELES NO SOLAPADOS */
.layout > div:first-child {
  display: grid !important;
  grid-template-rows: minmax(0, 1fr) auto !important;
  gap: 8px !important;
}
#prep-panel, .card {
  grid-row: 2 !important;
  position: relative !important;
  z-index: 1 !important;
}
#prep-panel[style*="display: flex"],
#prep-panel[style*="display:flex"] {
  display: flex !important;
}
#prep-panel[style*="display: flex"] ~ .card,
#prep-panel[style*="display:flex"] ~ .card {
  display: none !important;
}

/* TABLERO COMPLETO SIN CORTAR */
.layout > div:first-child {
  display: grid !important;
  grid-template-rows: minmax(0, 1fr) 100px !important;
  height: 100% !important;
  min-height: 0 !important;
  overflow: hidden !important;
}
.boardwrap {
  height: 100% !important;
  min-height: 0 !important;
  overflow: hidden !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}
#board {
  height: 100% !important;
  width: fit-content;
  max-height: 100% !important;
  max-width: fit-content;
  aspect-ratio: 8 / 12 !important;
  margin: auto !important;
}
#prep-panel, .card {
  height: 54px !important;
  max-height: 54px !important;
  overflow: hidden !important;
  box-sizing: border-box !important;
}

/* FORZAR TABLERO COMPLETO */
html, body {
  height: 100dvh !important;
  overflow: hidden !important;
}
main {
  height: 100% !important;
  min-height: 0 !important;
  display: flex !important;
  flex-direction: column !important;
}
.layout, .layout > div:first-child {
  flex: 1 1 0 !important;
  min-height: 0 !important;
  height: 100% !important;
  display: flex !important;
  flex-direction: column !important;
}
.boardwrap {
  flex: 1 1 0 !important;
  min-height: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  overflow: hidden !important;
}
#board {
  height: 100% !important;
  width: fit-content;
  max-height: 100% !important;
  aspect-ratio: 8 / 12 !important;
  margin: auto !important;
}
#prep-panel, .card {
  flex: 0 0 auto !important;
  max-height: 54px !important;
  overflow: hidden !important;
}



/* TAMAÃƒÆ’Ã¢â‚¬ËœO SEGURO */
#board {
  display: grid !important;
  grid-template-columns: repeat(8, 38px) !important;
  grid-template-rows: repeat(12, 38px) !important;
  gap: 2px !important;
  width: fit-content !important;
  margin: 2px auto !important;
}
.cell {
  width: 38px !important;
  height: 38px !important;
}

/* LAYOUT LATERAL */
.layout > div:first-child {
  display: grid !important;
  grid-template-columns: 1fr 280px !important;
  grid-template-rows: 1fr !important;
  gap: 10px !important;
  height: 100% !important;
  min-height: 0 !important;
}
.boardwrap {
  grid-column: 1 !important;
  grid-row: 1 !important;
  height: 100% !important;
  min-height: 0 !important;
}
#prep-panel, .card {
  grid-column: 2 !important;
  grid-row: 1 !important;
  height: 100% !important;
  max-height: none !important;
  overflow-y: auto !important;
  align-self: stretch !important;
}

/* PANEL LATERAL PULIDO */
#prep-panel, .card {
  grid-column: 2 !important;
  grid-row: 1 !important;
  height: auto !important;
  max-height: 100% !important;
  align-self: center !important;
  padding: 16px 14px !important;
  border-radius: 12px !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 10px !important;
  overflow: visible !important;
}
#prep-title {
  font-size: 13px !important;
  letter-spacing: 0.5px !important;
  margin: 0 0 4px !important;
}
#prep-help {
  font-size: 12px !important;
  line-height: 1.45 !important;
  margin: 0 0 8px !important;
  color: var(--muted) !important;
}
#prep-confirm {
  min-height: 38px !important;
  margin-top: auto !important;
  font-weight: 700 !important;
}
.card h3 {
  font-size: 11px !important;
  letter-spacing: 1.5px !important;
  margin: 0 0 6px !important;
}
.status {
  font-size: 13px !important;
  line-height: 1.4 !important;
  margin-bottom: 8px !important;
}
.controls {
  display: grid !important;
  grid-template-columns: 1fr 1fr 1fr !important;
  gap: 6px !important;
  margin-top: 8px !important;
}
.controls button {
  height: 38px !important;
  font-size: 15px !important;
}
.hint {
  font-size: 10px !important;
  margin-top: 8px !important;
  text-align: center !important;
}

/* PANEL ANCLADO ABAJO */
#prep-panel, .card {
  align-self: end !important;
  margin-top: auto !important;
  height: auto !important;
  max-height: none !important;
}
.layout > div:first-child {
  align-items: stretch !important;
}
/* Ganar un poco mÃƒÆ’Ã‚Â¡s de espacio vertical */
.topbar {
  margin-bottom: 4px !important;
}
.player {
  padding: 5px 8px !important;
}
header {
  padding-top: 4px !important;
  padding-bottom: 2px !important;
}

/* REFINAMIENTO FINAL */
.boardwrap {
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
}
#prep-panel, .card {
  background: rgba(17, 25, 39, 0.92) !important;
  backdrop-filter: blur(6px) !important;
  border: 1px solid rgba(255, 209, 102, 0.25) !important;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35) !important;
  width: 260px !important;
  margin-left: auto !important;
}
.layout > div:first-child {
  grid-template-columns: 1fr 270px !important;
}
.controls button {
  background: #1a2a40 !important;
  border-color: #3a4d68 !important;
}
.controls button:hover {
  background: #243650 !important;
  border-color: var(--gold) !important;
}
#prep-confirm {
  background: #174b77 !important;
  border-color: #277fbd !important;
}
#prep-confirm:hover {
  background: #1e5a8a !important;
}

/* LIMPIAR DOBLE BORDE */
.card, #prep-panel {
  border: 1px solid rgba(255, 209, 102, 0.2) !important;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25) !important;
  outline: none !important;
}
.card::before, .card::after,
#prep-panel::before, #prep-panel::after {
  display: none !important;
}

/* CENTRAR TABLERO Y LIMPIAR BORDE */
.layout > div:first-child {
  grid-template-columns: 1fr 260px !important;
  justify-items: center !important;
}
.boardwrap {
  width: 100% !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}
#board {
  margin: 0 auto !important;
}
.card, #prep-panel {
  border: none !important;
  box-shadow: 0 0 0 1px rgba(255, 209, 102, 0.18), 0 8px 24px rgba(0,0,0,.3) !important;
  background: #111927 !important;
}

/* OCULTAR PREP-PANEL CUANDO NO CORRESPONDE */
#prep-panel {
  display: none !important;
}
#prep-panel[style*="display: flex"],
#prep-panel[style*="display:flex"] {
  display: flex !important;
}
#prep-panel[style*="display: flex"] ~ .card,
#prep-panel[style*="display:flex"] ~ .card {
  display: none !important;
}

/* PANEL QUE CABE COMPLETO */
#prep-panel, .card {
  width: 240px !important;
  max-width: 240px !important;
  margin-right: 8px !important;
  margin-bottom: 8px !important;
  padding: 12px 12px !important;
  align-self: end !important;
}
.layout > div:first-child {
  grid-template-columns: 1fr 250px !important;
  padding-right: 4px !important;
}
.controls button {
  height: 32px !important;
  font-size: 14px !important;
}
.hint {
  font-size: 9px !important;
  margin-top: 6px !important;
}

/* CENTRAR TABLERO EN SU ZONA */
.layout > div:first-child {
  display: grid !important;
  grid-template-columns: 1fr 250px !important;
  justify-items: center !important;
  align-items: center !important;
}
.boardwrap {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  width: 100% !important;
  height: 100% !important;
}
#board {
  margin: auto !important;
}

/* CENTRADO REAL */
.layout > div:first-child {
  display: flex !important;
  flex-direction: row !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 20px !important;
  height: 100% !important;
}
.boardwrap {
  flex: 0 0 auto !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}
#prep-panel, .card {
  flex: 0 0 240px !important;
  align-self: flex-end !important;
  margin-bottom: 10px !important;
}

/* LAYOUT CORREGIDO */
.layout > div:first-child {
  display: grid !important;
  grid-template-columns: 1fr 250px !important;
  grid-template-rows: 1fr !important;
  height: 100% !important;
  align-items: center !important;
  justify-items: center !important;
}
.boardwrap {
  grid-column: 1 !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  width: 100% !important;
  height: 100% !important;
}
#board {
  margin: auto !important;
}
#prep-panel, .card {
  grid-column: 2 !important;
  align-self: end !important;
  justify-self: end !important;
  margin: 0 10px 10px 0 !important;
  width: 230px !important;
}

/* CENTRAR CONJUNTO */
.layout > div:first-child {
  display: flex !important;
  flex-direction: row !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 30px !important;
  height: 100% !important;
  width: 100% !important;
}
.boardwrap {
  flex: 0 0 auto !important;
}
#prep-panel, .card {
  flex: 0 0 230px !important;
  align-self: flex-end !important;
  margin-bottom: 12px !important;
}

/* PANEL ABSOLUTO + TABLERO CENTRADO */
.layout > div:first-child {
  position: relative !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  height: 100% !important;
  width: 100% !important;
}
.boardwrap {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}
#prep-panel, .card {
  position: absolute !important;
  right: 12px !important;
  bottom: 12px !important;
  width: 230px !important;
  z-index: 5 !important;
}

/* PULIDO FINAL */
#prep-panel, .card {
  right: 16px !important;
  bottom: 16px !important;
  width: 240px !important;
  padding: 14px !important;
  border-radius: 14px !important;
}
.controls button {
  height: 34px !important;
  border-radius: 8px !important;
}
#board {
  filter: drop-shadow(0 4px 12px rgba(0,0,0,.25));
}

/* ACABADO PROFESIONAL */
#board {
  filter: drop-shadow(0 6px 16px rgba(0,0,0,.3));
}
.cell {
  border-radius: 4px !important;
  transition: background .1s ease;
}
#prep-panel, .card {
  background: rgba(15, 22, 35, 0.95) !important;
  border: 1px solid rgba(255, 209, 102, 0.15) !important;
  box-shadow: 0 10px 40px rgba(0,0,0,.4) !important;
  backdrop-filter: blur(8px);
  padding: 16px !important;
  border-radius: 16px !important;
}
.card h3, #prep-title {
  font-size: 11px !important;
  letter-spacing: 1.2px !important;
  text-transform: uppercase !important;
  opacity: 0.7 !important;
}
.status, #prep-help {
  font-size: 13px !important;
  line-height: 1.4 !important;
}
.controls button {
  height: 36px !important;
  font-size: 16px !important;
  border-radius: 10px !important;
}
#prep-confirm {
  height: 40px !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  border-radius: 10px !important;
}
.hint {
  opacity: 0.5 !important;
  font-size: 10px !important;
}
</style>

<style>
/* ACABADO TÃƒÆ’Ã‚ÂCTIL LOCAL */
.cell {
  background: linear-gradient(145deg, #243044 0%, #1a2438 100%) !important;
  box-shadow: inset 0 1px 1px rgba(255,255,255,.06), 0 1px 2px rgba(0,0,0,.3) !important;
  border-radius: 4px !important;
}
.cell.white, .cell.blue {
  background: linear-gradient(145deg, #ffffff 0%, #e8e8e8 100%) !important;
  box-shadow: inset 0 1px 1px rgba(255,255,255,.4), 0 2px 4px rgba(0,0,0,.25) !important;
}
.cell.black, .cell.red {
  background: linear-gradient(145deg, #3a3a3a 0%, #1a1a1a 100%) !important;
  box-shadow: inset 0 1px 1px rgba(255,255,255,.1), 0 2px 4px rgba(0,0,0,.4) !important;
}
.card, #prep-panel {
  background: rgba(15, 22, 35, 0.92) !important;
  backdrop-filter: blur(8px) !important;
  border: 1px solid rgba(255, 209, 102, 0.12) !important;
  box-shadow: 0 4px 20px rgba(0,0,0,.25) !important;
}
button:active {
  transform: translateY(1px) !important;
}
</style>

<style>
/* ESTILO COMERCIAL / TÃƒÆ’Ã‚ÂCTIL */
.cell {
  background: linear-gradient(160deg, #2d3d55 0%, #1c2838 100%) !important;
  border-radius: 6px !important;
  box-shadow: 
    inset 0 2px 2px rgba(255,255,255,.08),
    inset 0 -2px 3px rgba(0,0,0,.3),
    0 2px 4px rgba(0,0,0,.35) !important;
}
.cell.white, .cell.blue {
  background: linear-gradient(160deg, #ffffff 0%, #f0f0f0 50%, #d8d8d8 100%) !important;
  box-shadow: 
    inset 0 2px 3px rgba(255,255,255,.6),
    inset 0 -1px 2px rgba(0,0,0,.15),
    0 3px 6px rgba(0,0,0,.3) !important;
}
.cell.black, .cell.red {
  background: linear-gradient(160deg, #4a4a4a 0%, #2a2a2a 50%, #1a1a1a 100%) !important;
  box-shadow: 
    inset 0 2px 2px rgba(255,255,255,.12),
    inset 0 -2px 3px rgba(0,0,0,.5),
    0 3px 6px rgba(0,0,0,.4) !important;
}
button {
  border-radius: 10px !important;
  font-weight: 700 !important;
  letter-spacing: .3px !important;
  box-shadow: 0 2px 0 rgba(0,0,0,.3), 0 3px 8px rgba(0,0,0,.2) !important;
}
button:active {
  transform: translateY(2px) !important;
  box-shadow: 0 1px 0 rgba(0,0,0,.3) !important;
}
#find {
  background: linear-gradient(180deg, #2a7bc4 0%, #1a5a9a 100%) !important;
}
.card, #prep-panel, #controles-card, aside.side .card {
  border-radius: 16px !important;
  border: 1px solid rgba(255,255,255,.06) !important;
}
</style>

<style>
/* TEXTURA TÃƒÆ’Ã‚ÂCTIL LIMPIA */
.cell {
  background: 
    linear-gradient(180deg, rgba(255,255,255,.04) 0%, transparent 40%),
    #1e2a3c !important;
  border-radius: 5px !important;
  box-shadow: 
    inset 0 1px 0 rgba(255,255,255,.08),
    0 2px 3px rgba(0,0,0,.4) !important;
}
.cell.white, .cell.blue {
  background: 
    linear-gradient(180deg, #ffffff 0%, #f4f4f4 100%) !important;
  box-shadow: 
    inset 0 1px 0 rgba(255,255,255,.8),
    0 2px 4px rgba(0,0,0,.25) !important;
}
.cell.black, .cell.red {
  background: 
    linear-gradient(180deg, #3d3d3d 0%, #222 100%) !important;
  box-shadow: 
    inset 0 1px 0 rgba(255,255,255,.1),
    0 2px 4px rgba(0,0,0,.45) !important;
}
button {
  border-radius: 10px !important;
  box-shadow: 0 2px 0 #0a0e14, 0 3px 6px rgba(0,0,0,.25) !important;
}
button:active {
  transform: translateY(2px) !important;
  box-shadow: 0 0 0 #0a0e14 !important;
}
</style>

<style>
.cell {
  background: #1a2433 !important;
  border: 1px solid rgba(255,255,255,.04) !important;
  border-radius: 6px !important;
  box-shadow: inset 0 1px 2px rgba(0,0,0,.4) !important;
}
.cell.white, .cell.blue {
  background: #f5f5f5 !important;
  border: 1px solid rgba(0,0,0,.08) !important;
