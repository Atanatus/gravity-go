<script>
"use strict";
const W=8,H=12,GOAL=20,MATCH_SECONDS=600;
const BLUE=1,RED=2;
const SPAWN_ORDER=[3,4,2,5,1,6,0,7];
const $=id=>document.getElementById(id);
let board,piece,player,scores,mode,remaining,gameOver,paused,suddenDeath;
let lastFrame=0,fallAccumulator=0,turnWait=0,aiTarget=null,aiThink=0;
let lastStatus="",fastDrop=false,moveRepeat=0;
let diceRollId=0;
let prepPhase=false,prepSelectedColumn=null,prepOrder=[],prepIndex=0,openingPlayer=BLUE;
let prepColumns={[BLUE]:null,[RED]:null};

function say(s){lastStatus=s;$("status").textContent=s}
function currentIsAI(){return mode==="ai"&&player===RED}
function other(p){return p===BLUE?RED:BLUE}
function colorName(p){return p===BLUE?"Blanco":"Negro"}
function cloneBoard(b){return b.map(row=>row.slice())}
function emptyBoard(){return Array.from({length:H},()=>Array(W).fill(0))}
function inBounds(x,y){return x>=0&&x<W&&y>=0&&y<H}
function neighbors(x,y){return [[x-1,y],[x+1,y],[x,y-1],[x,y+1]].filter(([a,b])=>inBounds(a,b))}
function groupsOf(b){
 const seen=Array.from({length:H},()=>Array(W).fill(false)),groups=[];
 for(let y=0;y<H;y++)for(let x=0;x<W;x++){
  if(!b[y][x]||seen[y][x])continue;
  const c=b[y][x],stack=[[x,y]],stones=[],lib=new Set();seen[y][x]=true;
  while(stack.length){
   const [a,d]=stack.pop();stones.push([a,d]);
   for(const [nx,ny] of neighbors(a,d)){
    if(!b[ny][nx])lib.add(ny*W+nx);
    else if(b[ny][nx]===c&&!seen[ny][nx]){seen[ny][nx]=true;stack.push([nx,ny])}
   }
  }
  groups.push({color:c,stones,liberties:lib.size});
 }
 return groups;
}
function settle(b){
 let captured=[0,0,0],changed=true,loops=0;
 while(changed&&loops++<H*W){
  changed=false;
  const groups=groupsOf(b),remove=[];
  for(const g of groups)if(g.liberties===0)remove.push(...g.stones.map(([x,y])=>[x,y,g.color]));
  if(remove.length){
   changed=true;
   for(const [x,y,c] of remove){if(b[y][x]===c){b[y][x]=0;captured[c]++}}
  }
  if(changed){
   for(let x=0;x<W;x++){
    const stack=[];
    for(let y=H-1;y>=0;y--)if(b[y][x])stack.push(b[y][x]);
    for(let y=H-1;y>=0;y--)b[y][x]=stack[H-1-y]||0;
   }
  }
 }
 return captured;
}
function tryPlacement(b,x,y,p){
 const next=cloneBoard(b);
 if(!inBounds(x,y)||next[y][x])return {ok:false};
 next[y][x]=p;
 const captured=settle(next);
 const own=groupsOf(next).filter(g=>g.color===p);
 if(own.some(g=>g.liberties===0))return {ok:false,suicide:true};
 return {ok:true,board:next,captured};
}
function canOccupy(x,y){return inBounds(x,y)&&!board[y][x]}
function landingY(b,x){
 if(b[0][x])return -1;
 let y=0;
 while(y+1<H&&!b[y+1][x])y++;
 return y;
}
function spawnPiece(){
 let col=-1;
 for(const x of SPAWN_ORDER)if(!board[0][x]){col=x;break}
 if(col<0){finishByScore("No quedan columnas disponibles.");return}
 piece={x:col,y:0};
 fallAccumulator=0;fastDrop=false;
 if(currentIsAI()){
  aiTarget=chooseAITarget();aiThink=0;
 }else aiTarget=null;
 say(currentIsAI()?"La IA estÃƒÆ’Ã‚Â¡ pensando...":("Turno de "+colorName(player)+". Mueve tu cubo."));
 render();
}
function evaluateBoard(b){
 const groups=groupsOf(b);
 let value=0;
 for(let y=0;y<H;y++)for(let x=0;x<W;x++){
  if(b[y][x]===RED)value+=1.1;
  else if(b[y][x]===BLUE)value-=1.1;
 }
 for(const g of groups){
  const sign=g.color===RED?1:-1;
  value+=sign*Math.min(g.liberties,4)*g.stones.length*.55;
  if(g.liberties===1){
   value-=sign*3.8*g.stones.length;
  }
 }
 return value;
}
function tacticalValue(b,captured,redExtra,blueExtra){
 let value=evaluateBoard(b);
 value+=(captured[BLUE]-captured[RED])*8;
 const redTotal=scores[RED]+(redExtra||0)+captured[BLUE]-captured[RED];
 const blueTotal=scores[BLUE]+(blueExtra||0)+captured[RED]-captured[BLUE];
 if(redTotal>=GOAL)return 100000;
 if(blueTotal>=GOAL)return -100000;
 return value;
}
function aiSearch(b,depth,turn,redScore,blueScore){
 if(redScore>=GOAL)return 100000+depth;
 if(blueScore>=GOAL)return -100000-depth;

 let best=turn===RED?-Infinity:Infinity;
 let found=false;

 for(let x=0;x<W;x++){
  const y=landingY(b,x);
  if(y<0)continue;

  const move=tryPlacement(b,x,y,turn);
  if(!move.ok)continue;
  found=true;

  const redGain=move.captured[BLUE]||0;
  const blueGain=move.captured[RED]||0;
  const gained=turn===RED?redGain:blueGain;
  const nextRed=redScore+redGain-blueGain;
  const nextBlue=blueScore+blueGain-redGain;

  let value;
  if(suddenDeath&&gained>0){
   value=turn===RED?100000+depth:-100000-depth;
  }else if(nextRed>=GOAL){
   value=100000+depth;
  }else if(nextBlue>=GOAL){
   value=-100000-depth;
  }else if(depth<=1){
   value=evaluateBoard(move.board)+(nextRed-nextBlue)*12;
  }else{
   value=aiSearch(
    move.board,depth-1,other(turn),nextRed,nextBlue
   );
  }

  if(turn===RED){
   if(value>best)best=value;
  }else{
   if(value<best)best=value;
  }
 }

 if(!found){
  if(redScore>blueScore)return 90000+depth;
  if(blueScore>redScore)return -90000-depth;
  return evaluateBoard(b)+(redScore-blueScore)*12;
 }
 return best;
}
function chooseAITarget(){
 const candidates=[];
 let bestValue=-Infinity;

 for(let x=0;x<W;x++){
  const y=landingY(board,x);
  if(y<0)continue;

  const move=tryPlacement(board,x,y,RED);
  if(!move.ok)continue;

  const redGain=move.captured[BLUE]||0;
  const blueGain=move.captured[RED]||0;
  const redScore=scores[RED]+redGain-blueGain;
  const blueScore=scores[BLUE]+blueGain-redGain;

  let value;
  if(redScore>=GOAL){
   value=100000;
  }else if(suddenDeath&&redGain>0){
   value=100000;
  }else if(blueScore>=GOAL){
   value=-100000;
  }else{
   value=aiSearch(
    move.board,2,BLUE,redScore,blueScore
   );
  }

  // Ligera preferencia por capturar sin sacrificar grupos propios.
  value+=(redGain-blueGain)*1.5;
  candidates.push({x,value});

  if(value>bestValue)bestValue=value;
 }

 if(!candidates.length){
  for(const x of SPAWN_ORDER){
   if(!board[0][x])return x;
  }
  return piece?piece.x:3;
 }

 // Normalmente elige la mejor jugada; ocasionalmente varÃƒÆ’Ã‚Â­a
 // entre alternativas cercanas para evitar un juego mecÃƒÆ’Ã‚Â¡nico.
 const nearBest=candidates.filter(c=>c.value>=bestValue-2.5);
 if(nearBest.length>1&&Math.random()<0.14){
  const alternatives=nearBest.filter(c=>c.value<bestValue);
  if(alternatives.length){
   return alternatives[Math.floor(Math.random()*alternatives.length)].x;
  }
 }

 candidates.sort((a,b)=>b.value-a.value);
 return candidates[0].x;
}function prepAvailable(x){
 return Number.isInteger(x)&&x>=0&&x<W&&!Object.values(prepColumns).includes(x);
}
function prepSelect(x){
 if(!prepPhase||paused||gameOver||currentIsAI()||!prepAvailable(x))return;
 prepSelectedColumn=x;
 $("prep-confirm").disabled=false;
 say("Columna "+(x+1)+" seleccionada. Confirma tu ficha.");
 render();
}
function prepMove(dx){
 if(!prepPhase||paused||currentIsAI())return;
 let x=prepSelectedColumn===null?(dx>0?-1:W):prepSelectedColumn;
 for(let i=0;i<W;i++){
  x+=dx;if(x<0||x>=W)return;
  if(prepAvailable(x)){prepSelect(x);return;}
 }
}
function prepConfirm(){
 if(!prepPhase||paused||currentIsAI()||!prepAvailable(prepSelectedColumn))return;
 const p=player,x=prepSelectedColumn;
 board[H-1][x]=p;prepColumns[p]=x;prepSelectedColumn=null;prepIndex++;
 if(prepIndex>=prepOrder.length){
  prepPhase=false;
  $("prep-panel").style.display="none";
  say("PreparaciÃƒÆ’Ã‚Â³n completada. Comienza la partida.");
  beginTurn(openingPlayer);
  return;
 }
 player=prepOrder[prepIndex];
 say(currentIsAI()?"La IA prepara su ficha inicial.":"El segundo jugador: elige otra columna.");
 render();
 if(currentIsAI()){
  const col=SPAWN_ORDER.find(prepAvailable);
  if(col!==undefined){prepSelectedColumn=col;prepConfirmAI();}
 }
}
function prepConfirmAI(){
 if(!prepPhase||!currentIsAI()||!prepAvailable(prepSelectedColumn))return;
 const p=player,x=prepSelectedColumn;
 board[H-1][x]=p;prepColumns[p]=x;prepSelectedColumn=null;prepIndex++;
 if(prepIndex>=prepOrder.length){
  prepPhase=false;$("prep-panel").style.display="none";
  say("PreparaciÃƒÆ’Ã‚Â³n completada. Comienza la partida.");beginTurn(openingPlayer);return;
 }
 player=prepOrder[prepIndex];render();
 if(currentIsAI()){const col=SPAWN_ORDER.find(prepAvailable);if(col!==undefined){prepSelectedColumn=col;prepConfirmAI();}}
 else say("Elige una columna libre y confirma tu ficha inicial.");
}
function prepStart(winner){
 openingPlayer=winner;prepPhase=true;prepSelectedColumn=null;
 prepColumns={[BLUE]:null,[RED]:null};prepOrder=[winner,other(winner)];prepIndex=0;
 piece=null;player=prepOrder[0];paused=false;turnWait=0;fallAccumulator=0;aiTarget=null;fastDrop=false;
 $("pause").textContent="Pausar";
 $("prep-panel").style.display="flex";
 $("prep-confirm").disabled=true;
 say("El ganador de los dados elige primero su columna.");
 render();
 if(currentIsAI()){const col=SPAWN_ORDER.find(prepAvailable);if(col!==undefined){prepSelectedColumn=col;prepConfirmAI();}}
}
function movePiece(dx){
 if(!piece||gameOver||paused||currentIsAI())return;
 const nx=piece.x+dx;
 if(canOccupy(nx,piece.y)){piece.x=nx;render()}
}
function lockPiece(){
 if(!piece||gameOver)return;
 const x=piece.x,y=piece.y,p=player;
 const result=tryPlacement(board,x,y,p);
 piece=null;
 if(!result.ok){
  say(result.suicide?"Jugada anulada: suicidio prohibido. Turno perdido.":"Jugada no vÃƒÆ’Ã‚Â¡lida. Turno perdido.");
  turnWait=450;return;
 }
 board=result.board;
 const enemy=other(p);
 const gained=result.captured[enemy]||0;
 scores[p]+=gained;
 render();
 if(scores[p]>=GOAL){endGame(p,"Ãƒâ€šÃ‚Â¡"+colorName(p)+" alcanza las "+GOAL+" capturas!");return}
 if(suddenDeath&&gained>0){endGame(p,"Ãƒâ€šÃ‚Â¡Captura decisiva en muerte sÃƒÆ’Ã‚Âºbita!");return}
 if(gained>0)say(colorName(p)+" captura "+gained+" cubo"+(gained===1?"":"s")+".");
 else say("Cubo colocado. Sin capturas.");
 if(!hasAnySpawn()){
  finishByScore("El tablero estÃƒÆ’Ã‚Â¡ bloqueado.");
  return;
 }
 turnWait=550;
}
function hasAnySpawn(){return SPAWN_ORDER.some(x=>!board[0][x])}
function beginTurn(p){
 if(gameOver)return;
 player=p;piece=null;turnWait=0;fallAccumulator=0;aiTarget=null;
 spawnPiece();render();
}
function finishByScore(reason){
 if(scores[BLUE]>scores[RED])endGame(BLUE,reason+" MÃƒÆ’Ã‚Â¡s capturas acumuladas.");
 else if(scores[RED]>scores[BLUE])endGame(RED,reason+" MÃƒÆ’Ã‚Â¡s capturas acumuladas.");
 else if(reason.includes("bloqueado"))endGame(0,reason+" La puntuaciÃƒÆ’Ã‚Â³n estÃƒÆ’Ã‚Â¡ empatada.");
 else {suddenDeath=true;say("Ãƒâ€šÃ‚Â¡Muerte sÃƒÆ’Ã‚Âºbita! La siguiente captura decide la partida.");}
}
function endGame(winner,reason){
 gameOver=true;piece=null;paused=false;
 $("pause").textContent="Pausar";
 $("resultTitle").textContent=winner===0?"Ãƒâ€šÃ‚Â¡Tablas!":"Ãƒâ€šÃ‚Â¡Gana "+colorName(winner)+"!";
 $("resultText").textContent=reason+" Marcador final: Blanco "+scores[BLUE]+" ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â Negro "+scores[RED]+".";
 $("overlay").classList.add("show");
 say(reason);
 render();
}
function updateClock(){
 const n=Math.max(0,Math.ceil(remaining));
 $("time").textContent=String(Math.floor(n/60)).padStart(2,"0")+":"+String(n%60).padStart(2,"0");
 $("clock").classList.toggle("urgent",n<=60);
}
function render(){
 const el=$("board");el.replaceChildren();
 for(let y=0;y<H;y++)for(let x=0;x<W;x++){
  const cell=document.createElement("div");
  cell.className="cell"+(board[y][x]===BLUE?" blue":board[y][x]===RED?" red":"");
  if(piece&&piece.x===x&&piece.y===y)cell.classList.add("falling");
if(prepPhase&&y===H-1&&x===prepSelectedColumn&&prepAvailable(x))cell.classList.add("prep-preview");
  cell.setAttribute("aria-label",`Fila ${y+1}, columna ${x+1}`);
  cell.addEventListener("click",()=>{
   if(prepPhase){prepSelect(x);return;}
   if(!piece||gameOver||paused||currentIsAI())return;
   const dx=x-piece.x;
   if(dx)movePiece(Math.sign(dx));
  });
  el.appendChild(cell);
 }
 $("scoreBlue").textContent=scores[BLUE];
 $("scoreRed").textContent=scores[RED];
 $("pBlue").classList.toggle("active",!gameOver&&player===BLUE);
 $("pRed").classList.toggle("active",!gameOver&&player===RED);
 $("redName").textContent=mode==="ai"?"IA NEGRA":"JUGADOR NEGRO";
 $("left").disabled=!piece||paused||gameOver||currentIsAI();
 $("right").disabled=!piece||paused||gameOver||currentIsAI();
 $("down").disabled=prepPhase||!piece||paused||gameOver||currentIsAI();
if(prepPhase){
 $("prep-panel").style.display="flex";
 $("prep-confirm").disabled=paused||currentIsAI()||!prepAvailable(prepSelectedColumn);
 $("prep-title").textContent=prepSelectedColumn===null?"Ãƒâ€šÃ‚Â¿DÃƒÆ’Ã¢â‚¬Å“NDE QUIERES EMPEZAR?":"Ãƒâ€šÃ‚Â¿AQUÃƒÆ’Ã‚Â? Ãƒâ€šÃ‚Â· COLUMNA "+(prepSelectedColumn+1);
 $("prep-help").textContent="Jugador "+(player===BLUE?"1 Ãƒâ€šÃ‚Â· BLANCAS":"2 Ãƒâ€šÃ‚Â· NEGRAS")+". Toca una columna o usa las flechas ÃƒÂ¢Ã¢â‚¬Â Ã‚Â ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬â„¢. La ficha fantasma muestra dÃƒÆ’Ã‚Â³nde empezarÃƒÆ’Ã‚Â¡. Cuando te guste, pulsa Confirmar ficha.";
}else{
 $("prep-panel").style.display="none";
}
 updateClock();
}
function startDiceRoll(){
 const overlay=$("dice-overlay");
 const face1=$("dice-face-1");
 const face2=$("dice-face-2");
 const status=$("dice-status");
 const name1=$("dice-name-1");
 const name2=$("dice-name-2");
 const rollId=++diceRollId;

 name1.textContent=mode==="ai"?"TÃƒÆ’Ã…Â¡":"JUGADOR 1";
 name2.textContent=mode==="ai"?"IA":"JUGADOR 2";
 face1.textContent="ÃƒÂ¢Ã…Â¡Ã¢â‚¬Å¾";
 face2.textContent="ÃƒÂ¢Ã…Â¡Ã¢â‚¬Å¾";
 face1.classList.remove("rolling");
 face2.classList.remove("rolling");
 status.classList.remove("winner");
 status.textContent="Ãƒâ€šÃ‚Â¡Que empiece el duelo!";
 overlay.classList.add("show");

 function throwAgain(){
  if(rollId!==diceRollId)return;
  face1.classList.add("rolling");
  face2.classList.add("rolling");
  status.classList.remove("winner");
  status.textContent="Lanzando los dados...";
  const animation=setInterval(()=>{
   if(rollId!==diceRollId){clearInterval(animation);return;}
   face1.textContent=String(1+Math.floor(Math.random()*6));
   face2.textContent=String(1+Math.floor(Math.random()*6));
  },85);

  setTimeout(()=>{
   clearInterval(animation);
   if(rollId!==diceRollId)return;
   const a=1+Math.floor(Math.random()*6);
   const b=1+Math.floor(Math.random()*6);
   face1.textContent=String(a);
   face2.textContent=String(b);
   face1.classList.remove("rolling");
   face2.classList.remove("rolling");

   if(a===b){
    status.textContent="Ãƒâ€šÃ‚Â¡Empate! Repetimos el lanzamiento...";
    setTimeout(throwAgain,950);
    return;
   }

   const winner=a>b?BLUE:RED;
   const winnerName=mode==="ai"
    ?(winner===BLUE?"Ãƒâ€šÃ‚Â¡Empiezas tÃƒÆ’Ã‚Âº!":"Ãƒâ€šÃ‚Â¡Empieza la IA!")
    :"Ãƒâ€šÃ‚Â¡Empieza el Jugador "+(winner===BLUE?"1":"2")+"!";
   status.textContent=winnerName;
   status.classList.add("winner");

   setTimeout(()=>{
    if(rollId!==diceRollId)return;
    overlay.classList.remove("show");
    paused=false;
    $("pause").textContent="Pausar";
    prepStart(winner);
    render();
   },1450);
  },1450);
 }
 throwAgain();
}

function showMainMenu(){
 diceRollId++;
 paused=true;
 prepPhase=false;
 fastDrop=false;
 $("dice-overlay").classList.remove("show");
 $("pause-overlay").classList.remove("show");
 $("overlay").classList.remove("show");
 $("prep-panel").style.display="none";
 $("main-menu").classList.add("show");
}
function launchFromMenu(selectedMode){
 $("mode").value=selectedMode;
 $("main-menu").classList.remove("show");
 resetGame();
}
function resetGame(){
 diceRollId++;
 board=emptyBoard();piece=null;player=BLUE;scores={[BLUE]:0,[RED]:0};
 mode=$("mode").value;remaining=MATCH_SECONDS;gameOver=false;paused=true;
 suddenDeath=false;turnWait=0;lastFrame=0;fallAccumulator=0;aiTarget=null;
 fastDrop=false;moveRepeat=0;
 $("overlay").classList.remove("show");$("pause").textContent="Pausar";
 say("Decidiendo quiÃƒÆ’Ã‚Â©n empieza...");
 render();
 startDiceRoll();
}
function tick(now){
 requestAnimationFrame(tick);
 if(!lastFrame)lastFrame=now;
 const dt=Math.min((now-lastFrame)/1000,.1);lastFrame=now;
 if(gameOver||paused||prepPhase){return}
 if(!suddenDeath){
  remaining-=dt;
  if(remaining<=0){
   remaining=0;updateClock();
   if(scores[BLUE]===scores[RED]){
    suddenDeath=true;
    say("Ãƒâ€šÃ‚Â¡Tiempo! Empate a puntos. Muerte sÃƒÆ’Ã‚Âºbita: la siguiente captura gana.");
   }else{
    endGame(scores[BLUE]>scores[RED]?BLUE:RED,"Tiempo agotado.");
    return;
   }
  }
 }
 updateClock();
 if(turnWait>0){
  turnWait-=dt*1000;
  if(turnWait<=0&&!gameOver)beginTurn(other(player));
  return;
 }
 if(!piece||gameOver)return;
 if(currentIsAI()){
  aiThink+=dt;
  if(aiTarget!==null&&piece.x!==aiTarget&&aiThink>.11){
   aiThink=0;
   const dx=Math.sign(aiTarget-piece.x),nx=piece.x+dx;
   if(canOccupy(nx,piece.y))piece.x=nx;
   else aiTarget=piece.x;
   render();
  }
 }
 fallAccumulator+=dt;
 const interval=fastDrop?.045:(currentIsAI()?.40:.48);
 if(fallAccumulator>=interval){
  fallAccumulator=0;
  if(canOccupy(piece.x,piece.y+1)){piece.y++}
  else{lockPiece();return}
  render();
 }
}
function togglePause(){
 if(gameOver||$("dice-overlay").classList.contains("show"))return;
 paused=!paused;
 $("pause").textContent=paused?"Continuar":"Pausar";
 $("pause-overlay").classList.toggle("show",paused);
 fastDrop=false;
 say(paused?"Partida pausada.":(suddenDeath?"Muerte sÃƒÆ’Ã‚Âºbita: la siguiente captura decide.":lastStatus));
 render();
}
$("menu-ai").addEventListener("click",()=>launchFromMenu("ai"));
$("menu-local").addEventListener("click",()=>launchFromMenu("local"));
$("menu-online").addEventListener("click",()=>{window.location.href="online.html";});
$("to-menu").addEventListener("click",showMainMenu);
$("pause-continue").addEventListener("click",togglePause);
$("pause-to-menu").addEventListener("click",showMainMenu);
$("prep-confirm").addEventListener("click",prepConfirm);
$("left").addEventListener("click",()=>prepPhase?prepMove(-1):movePiece(-1));
$("right").addEventListener("click",()=>prepPhase?prepMove(1):movePiece(1));
$("down").addEventListener("pointerdown",()=>{if(!currentIsAI()&&!paused&&!gameOver)fastDrop=true});
["pointerup","pointercancel","pointerleave"].forEach(ev=>$("down").addEventListener(ev,()=>fastDrop=false));
$("new")?.addEventListener("click",resetGame);
$("again").addEventListener("click",resetGame);
$("pause").addEventListener("click",togglePause);
$("mode").addEventListener("change",resetGame);
document.addEventListener("keydown",e=>{
 const k=e.key.toLowerCase();
 if(["arrowleft","arrowright","arrowdown"," ","a","d","s"].includes(k))e.preventDefault();
 if(k==="p"&&!e.repeat){togglePause();return}
 if(e.repeat||!piece||gameOver||paused||currentIsAI())return;

 if(mode==="local"){
  if(player===BLUE){
   if(k==="arrowleft")movePiece(-1);
   if(k==="arrowright")movePiece(1);
   if(k==="arrowdown")fastDrop=true;
  }else{
   if(k==="a")movePiece(-1);
   if(k==="d")movePiece(1);
   if(k==="s")fastDrop=true;
  }
 }else{
  if(k==="arrowleft")movePiece(-1);
  if(k==="arrowright")movePiece(1);
  if(k==="arrowdown")fastDrop=true;
 }

 if(k===" "){fastDrop=false;lockPiece()}
});
document.addEventListener("keyup",e=>{
 const k=e.key.toLowerCase();
 if(k==="arrowdown"||k==="s")fastDrop=false;
});
resetGame();
requestAnimationFrame(tick);
</script>




<script>
// FIX GRID FORZADO POR JS
(function() {
  const style = document.createElement('style');
  style.textContent = `
    
    .cell {
      aspect-ratio: 1 !important;
      min-width: fit-content;
      background: #182437 !important;
      border: 1px solid #29374d !important;
    }
  `;
  document.head.appendChild(style);
})();
</script>

<script>
// AJUSTE AUTOMÃƒÆ’Ã‚ÂTICO DEL TABLERO
(function() {
  function fitBoard() {
    const wrap = document.querySelector('.boardwrap');
    const board = document.getElementById('board');
    if (!wrap || !board) return;

    const gap = 3;
    const cols = 8, rows = 12;
    const availableW = wrap.clientWidth - 16;
    const availableH = wrap.clientHeight - 16;

    if (availableW < 50 || availableH < 50) return;

    const cell = Math.floor(Math.min(
      (availableW - gap * (cols - 1)) / cols,
      (availableH - gap * (rows - 1)) / rows
    ));

    if (cell < 8) return;

    board.style.width = (cols * cell + (cols - 1) * gap) + 'px';
    board.style.height = (rows * cell + (rows - 1) * gap) + 'px';
    board.style.gridTemplateColumns = `repeat(${cols}, ${cell}px)`;
    board.style.gridTemplateRows = `repeat(${rows}, ${cell}px)`;
    board.style.gap = gap + 'px';
    board.style.margin = 'auto';
  }

  const start = () => {
    fitBoard();
    window.addEventListener('resize', fitBoard);
    if (window.ResizeObserver) {
      new ResizeObserver(fitBoard).observe(document.querySelector('.boardwrap'));
    }
    setTimeout(fitBoard, 100);
    setTimeout(fitBoard, 500);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>

<script>
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

function playTone(freq, duration, type = 'sine', gain = 0.15) {
  const osc = audioCtx.createOscillator();
  const g = audioCtx.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
  g.gain.setValueAtTime(gain, audioCtx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
  osc.connect(g);
  g.connect(audioCtx.destination);
  osc.start();
  osc.stop(audioCtx.currentTime + duration);
}

function soundMove() { playTone(440, 0.08, 'sine', 0.08); }
function soundDrop() { playTone(220, 0.12, 'triangle', 0.1); }
function soundLock() { playTone(330, 0.15, 'sine', 0.12); playTone(440, 0.1, 'sine', 0.06); }
function soundCapture() { playTone(523, 0.1, 'sine', 0.1); setTimeout(() => playTone(659, 0.12, 'sine', 0.08), 80); }

// Enganchar a funciones existentes si estÃƒÆ’Ã‚Â¡n disponibles
const origMove = window.movePiece;
if (typeof origMove === 'function') {
  window.movePiece = function(dx) { soundMove(); return origMove(dx); };
}
</script>

<script>
const ctx = new (window.AudioContext || window.webkitAudioContext)();

function noise(duration) {
  const bufferSize = ctx.sampleRate * duration;
  const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
  const src = ctx.createBufferSource();
  src.buffer = buffer;
  return src;
}

function playClick() {
  const n = noise(0.04);
  const f = ctx.createBiquadFilter();
  f.type = 'bandpass';
  f.frequency.value = 1800;
  f.Q.value = 2;
  const g = ctx.createGain();
  g.gain.setValueAtTime(0.25, ctx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
  n.connect(f); f.connect(g); g.connect(ctx.destination);
  n.start();
}

function playSlide() {
  const o = ctx.createOscillator();
  const g = ctx.createGain();
  o.type = 'triangle';
  o.frequency.setValueAtTime(280, ctx.currentTime);
  o.frequency.linearRampToValueAtTime(180, ctx.currentTime + 0.08);
  g.gain.setValueAtTime(0.12, ctx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
  o.connect(g); g.connect(ctx.destination);
  o.start(); o.stop(ctx.currentTime + 0.1);
}

function playDrop() {
  const n = noise(0.08);
  const f = ctx.createBiquadFilter();
  f.type = 'lowpass';
  f.frequency.value = 400;
  const g = ctx.createGain();
  g.gain.setValueAtTime(0.3, ctx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
  n.connect(f); f.connect(g); g.connect(ctx.destination);
  n.start();
}

function playPlace() {
  const o = ctx.createOscillator();
  const g = ctx.createGain();
  o.type = 'sine';
  o.frequency.setValueAtTime(180, ctx.currentTime);
  o.frequency.exponentialRampToValueAtTime(90, ctx.currentTime + 0.15);
  g.gain.setValueAtTime(0.2, ctx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.18);
  o.connect(g); g.connect(ctx.destination);
  o.start(); o.stop(ctx.currentTime + 0.18);
  setTimeout(playClick, 40);
}

function playCapture() {
  playPlace();
  setTimeout(() => {
    const o = ctx.createOscillator();
    const g = ctx.createGain();
    o.type = 'sine';
    o.frequency.value = 520;
    g.gain.setValueAtTime(0.1, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);
    o.connect(g); g.connect(ctx.destination);
    o.start(); o.stop(ctx.currentTime + 0.2);
  }, 60);
}

function playUI() {
  const o = ctx.createOscillator();
  const g = ctx.createGain();
  o.type = 'sine';
  o.frequency.value = 660;
  g.gain.setValueAtTime(0.08, ctx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
  o.connect(g); g.connect(ctx.destination);
  o.start(); o.stop(ctx.currentTime + 0.08);
}

document.addEventListener('click', e => {
  if (e.target.tagName === 'BUTTON') playUI();
}, true);

const _move = window.movePiece;
if (typeof _move === 'function') {
  window.movePiece = function(dx) { playSlide(); return _move.call(this, dx); };
}
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  
  function tone(freq, dur, type='sine', vol=0.1) {
    const o = ctx.createOscillator();
    const g = ctx.createGain();
    o.type = type;
    o.frequency.value = freq;
    g.gain.setValueAtTime(vol, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
    o.connect(g); g.connect(ctx.destination);
    o.start(); o.stop(ctx.currentTime + dur);
  }
  
  function click() { tone(1200, 0.03, 'square', 0.05); }
  function slide() { tone(300, 0.06, 'triangle', 0.08); }
  function drop() { tone(150, 0.1, 'sawtooth', 0.1); }
  function place() { tone(200, 0.12, 'sine', 0.15); setTimeout(() => tone(400, 0.06, 'sine', 0.08), 50); }
  
  const left = document.getElementById('left');
  const right = document.getElementById('right');
  const down = document.getElementById('down');
  
  if (left) left.addEventListener('click', slide);
  if (right) right.addEventListener('click', slide);
  if (down) {
    down.addEventListener('pointerdown', drop);
    down.addEventListener('pointerup', () => tone(100, 0.05, 'sine', 0.06));
  }
  
  document.querySelectorAll('button').forEach(btn => {
    if (!['left','right','down'].includes(btn.id)) {
      btn.addEventListener('click', click);
    }
  });
  
  console.log('Sonidos de control activos');
});
</script>

<script>
(function() {
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  const resume = () => { if (ctx.state === 'suspended') ctx.resume(); };
  document.addEventListener('click', resume, { once: true });
  document.addEventListener('keydown', resume, { once: true });

  function tone(f, d, t='sine', v=0.12) {
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.type = t; o.frequency.value = f;
    g.gain.setValueAtTime(v, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + d);
    o.connect(g); g.connect(ctx.destination);
    o.start(); o.stop(ctx.currentTime + d);
  }
  const S = {
    select: () => tone(520, 0.06, 'sine', 0.08),
    confirm: () => { tone(440, 0.08); setTimeout(() => tone(660, 0.1), 60); },
    drop: () => tone(180, 0.1, 'triangle', 0.1),
    place: () => { tone(220, 0.12, 'sine', 0.14); setTimeout(() => tone(110, 0.08, 'sine', 0.08), 40); },
    capture: () => { tone(330, 0.08); setTimeout(() => tone(440, 0.1), 50); setTimeout(() => tone(550, 0.12), 100); },
    enemy: () => tone(160, 0.1, 'triangle', 0.08)
  };

  const tryHook = setInterval(() => {
    if (typeof window.lockPiece === 'function' && !window._soundHooked) {
      const origLock = window.lockPiece;
      window.lockPiece = function() { S.place(); return origLock.apply(this, arguments); };
      
      const origMove = window.movePiece;
      if (typeof origMove === 'function') {
        window.movePiece = function(dx) { S.select(); return origMove.apply(this, arguments); };
      }
      
      window._soundHooked = true;
      clearInterval(tryHook);
      console.log('Sonidos enganchados a funciones del juego');
    }
  }, 200);

  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown' || e.key === 's') S.drop();
  });
  
  const down = document.getElementById('down');
  if (down) down.addEventListener('pointerdown', () => S.drop());
})();
</script>

<script>
(function(){
  const ctx = new (window.AudioContext||window.webkitAudioContext)();
  const resume = ()=>{if(ctx.state==='suspended')ctx.resume()};
  document.addEventListener('pointerdown',resume,{once:true});

  function hit(freq,dur,type,vol){
    const o=ctx.createOscillator(),g=ctx.createGain();
    o.type=type||'sine';
    o.frequency.setValueAtTime(freq,ctx.currentTime);
    o.frequency.exponentialRampToValueAtTime(freq*0.5,ctx.currentTime+dur);
    g.gain.setValueAtTime(vol||0.15,ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+dur);
    o.connect(g);g.connect(ctx.destination);
    o.start();o.stop(ctx.currentTime+dur);
  }
  function thud(){hit(120,0.09,'triangle',0.18)}
  function tap(){hit(800,0.025,'square',0.04)}
  function slide(){hit(240,0.05,'triangle',0.07)}
  function lock(){thud();setTimeout(()=>hit(180,0.06,'sine',0.1),30)}
  function capture(){lock();setTimeout(()=>hit(520,0.08,'sine',0.08),80)}

  const hook=setInterval(()=>{
    if(typeof lockPiece==='function'&&!window._s){
      const ol=lockPiece;
      window.lockPiece=function(){lock();return ol.apply(this,arguments)};
      if(typeof movePiece==='function'){
        const om=movePiece;
        window.movePiece=function(d){slide();return om.apply(this,arguments)};
      }
      window._s=1;clearInterval(hook);
    }
  },150);

  document.addEventListener('keydown',e=>{
    if(e.key==='ArrowDown'||e.key==='s')thud();
  });
  const d=document.getElementById('down');
  if(d)d.addEventListener('pointerdown',thud);

  document.querySelectorAll('#prep-confirm,.menu-option,.primary').forEach(b=>{
    b.addEventListener('click',tap);
  });
})();
</script>
</body>
</html>

