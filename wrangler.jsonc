{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gravity-go-online",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_HUB",
        "class_name": "GameHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameHub"]
    }
  ]
}
